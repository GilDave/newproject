diff --git a/ena_bot/hayes_rpc.py b/ena_bot/hayes_rpc.py
new file mode 100644
index 0000000..4160f94
--- /dev/null
+++ b/ena_bot/hayes_rpc.py
@@ -0,0 +1,80 @@
+"""키 없는 EVM JSON-RPC 공급자. 지갑의 ENA(ERC-20) 직접 보유량만 온체인에서 읽는다.
+
+`hayes_holdings.provider_url`을 "evm_rpc"로 두면 수집기가 이 모듈을 쓴다(API 키 불필요).
+계약 주소가 실제 ENA가 맞는지 `symbol()`로 확인하고, 소수 자릿수도 `decimals()`로 직접 읽는다.
+"""
+
+from __future__ import annotations
+
+import json
+import urllib.request
+
+PROVIDER_NAME = "evm_rpc"
+EXPECTED_SYMBOL = "ENA"
+# 이더리움 메인넷 ENA. 반드시 Etherscan에서 한 번 더 확인할 것(틀려도 symbol 검사가 막는다).
+ENA_ETHEREUM = "0x57e114b691db790c35207b2e685d4a43181e6061"
+
+DEFAULT_RPC_URLS = {
+    "ethereum": ["https://ethereum-rpc.publicnode.com", "https://eth.llamarpc.com"],
+}
+
+SEL_BALANCE_OF = "0x70a08231"
+SEL_SYMBOL = "0x95d89b41"
+SEL_DECIMALS = "0x313ce567"
+
+
+def default_rpc(url: str, method: str, params: list):
+    body = json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params}).encode()
+    req = urllib.request.Request(url, data=body, headers={"Content-Type": "application/json", "Accept": "application/json"})
+    with urllib.request.urlopen(req, timeout=20) as r:  # noqa: S310 - 설정된 RPC URL
+        out = json.loads(r.read().decode("utf-8"))
+    if out.get("error"):
+        raise RuntimeError(f"RPC 오류: {out['error']}")
+    return out["result"]
+
+
+def _call(rpc, urls: list, to: str, data: str) -> str:
+    last = None
+    for u in urls:
+        try:
+            res = rpc(u, "eth_call", [{"to": to, "data": data}, "latest"])
+            if isinstance(res, str) and res.startswith("0x") and len(res) > 2:
+                return res
+            last = RuntimeError(f"빈 응답: {res!r}")
+        except Exception as exc:  # 다음 RPC로 넘어간다
+            last = exc
+    raise RuntimeError(f"모든 RPC 실패: {type(last).__name__}: {last}")
+
+
+def decode_string(hexstr: str) -> str:
+    raw = bytes.fromhex(hexstr[2:])
+    if len(raw) == 32:  # bytes32 형식 심볼
+        return raw.rstrip(b"\x00").decode("utf-8", "replace")
+    if len(raw) < 64:
+        raise ValueError("문자열 응답 형식 오류")
+    off = int.from_bytes(raw[:32], "big")
+    n = int.from_bytes(raw[off:off + 32], "big")
+    return raw[off + 32:off + 32 + n].decode("utf-8", "replace")
+
+
+def make_fetch(rpc_urls: dict | None = None, rpc=None):
+    """수집기의 fetch 계약((url, params, headers) -> {'balance','decimals'})을 만족하는 함수."""
+    rpc = rpc or default_rpc
+    urls_by_chain = {**DEFAULT_RPC_URLS, **{k: list(v) for k, v in (rpc_urls or {}).items()}}
+    verified: dict = {}
+
+    def fetch(_url: str, params: dict, _headers: dict) -> dict:
+        chain, wallet, contract = params["chain"], params["wallet"], params["contract"]
+        urls = urls_by_chain.get(chain)
+        if not urls:
+            raise ValueError(f"{chain}용 RPC URL이 없다(config의 hayes_holdings.rpc_urls에 추가)")
+        key = (chain, contract)
+        if key not in verified:
+            sym = decode_string(_call(rpc, urls, contract, SEL_SYMBOL))
+            if sym != EXPECTED_SYMBOL:
+                raise ValueError(f"계약 {contract}의 심볼이 {sym!r}이다(ENA 아님)")
+            verified[key] = int(_call(rpc, urls, contract, SEL_DECIMALS), 16)
+        data = SEL_BALANCE_OF + wallet[2:].rjust(64, "0")
+        return {"balance": str(int(_call(rpc, urls, contract, data), 16)), "decimals": verified[key]}
+
+    return fetch
diff --git a/tests/test_hayes_rpc.py b/tests/test_hayes_rpc.py
new file mode 100644
index 0000000..103293e
--- /dev/null
+++ b/tests/test_hayes_rpc.py
@@ -0,0 +1,80 @@
+import json
+from ena_bot import hayes_holdings as h
+from ena_bot.hayes_rpc import make_fetch, ENA_ETHEREUM, SEL_SYMBOL, SEL_DECIMALS, SEL_BALANCE_OF
+
+W1 = "0x" + "11" * 20
+W2 = "0x" + "22" * 20
+
+
+def _str(s):
+    b = s.encode()
+    return "0x" + (32).to_bytes(32, "big").hex() + len(b).to_bytes(32, "big").hex() + b.ljust(32, b"\0").hex()
+
+
+def fake_rpc(symbol="ENA", balances=None, fail_urls=()):
+    balances = balances or {}
+
+    def rpc(url, method, params):
+        if url in fail_urls:
+            raise OSError("down")
+        data = params[0]["data"]
+        if data == SEL_SYMBOL:
+            return _str(symbol)
+        if data == SEL_DECIMALS:
+            return hex(18)
+        assert data.startswith(SEL_BALANCE_OF)
+        return hex(balances.get("0x" + data[-40:], 0))
+    return rpc
+
+
+def cfg(entries):
+    return h.HoldingsConfig(entries=entries, provider_url="evm_rpc")
+
+
+def ent(w):
+    return {"chain": "ethereum", "wallet": w, "contract": ENA_ETHEREUM, "attribution_url": "https://x.example/a"}
+
+
+def test_collect_ok_without_key(tmp_path):
+    conn = h.connect(tmp_path / "d.sqlite")
+    f = make_fetch(rpc=fake_rpc(balances={W1: 5 * 10**18, W2: 10**18 // 2}))
+    r = h.collect_once(conn, cfg([ent(W1), ent(W2)]), env={}, fetch=f)
+    assert r["status"] == "ok"
+    assert h.latest_snapshot(conn)["total"] == "5.500000000000000000"
+    assert h.latest_snapshot(conn)["source"] == "evm_rpc"
+
+
+def test_wrong_symbol_rejected(tmp_path):
+    conn = h.connect(tmp_path / "d.sqlite")
+    f = make_fetch(rpc=fake_rpc(symbol="SCAM", balances={W1: 1}))
+    r = h.collect_once(conn, cfg([ent(W1)]), env={}, fetch=f)
+    assert r["status"] == "request_failed" and "ENA 아님" in r["detail"]
+    assert h.latest_snapshot(conn) is None
+
+
+def test_rpc_fallback(tmp_path):
+    f = make_fetch(rpc_urls={"ethereum": ["https://bad", "https://good"]}, rpc=fake_rpc(balances={W1: 10**18}, fail_urls=("https://bad",)))
+    assert f("", {"chain": "ethereum", "wallet": W1, "contract": ENA_ETHEREUM}, {})["balance"] == str(10**18)
+
+
+def test_empty_and_legacy_behaviour_kept(tmp_path):
+    conn = h.connect(tmp_path / "d.sqlite")
+    assert h.collect_once(conn, h.HoldingsConfig(), env={})["status"] == "empty_config"
+    assert h.collect_once(conn, h.HoldingsConfig(entries=[ent(W1)]), env={})["status"] == "missing_provider"
+    c = h.HoldingsConfig(entries=[ent(W1)], provider_url="https://p.example/x")
+    assert h.collect_once(conn, c, env={})["status"] == "missing_key"
+
+
+def test_add_and_check(tmp_path):
+    p = tmp_path / "config.json"
+    p.write_text(json.dumps({"data_dir": "data"}))
+    h.add_entry(p, W1, "https://arkham.example/a")
+    c, _ = h.load_config(p)
+    assert c.provider_url == "evm_rpc" and len(c.entries) == 1
+    lines = h.check_entries(c, fetch=make_fetch(rpc=fake_rpc(balances={W1: 2 * 10**18})))
+    assert lines[0].startswith("OK") and "2.000000000000000000" in lines[0]
+    try:
+        h.add_entry(p, "0xbad", "https://x.example")
+        assert False
+    except h.HoldingsError:
+        pass
