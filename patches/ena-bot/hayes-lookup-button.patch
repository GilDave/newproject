+++ b/ena_bot/hayes_lookup.py
@@ -0,0 +1,47 @@
+"""대시보드 '주소 조회·등록' 버튼의 서버 쪽 로직. 온체인에서 ENA 보유량을 읽고, 확인한 지갑만 config.json에 등록한다."""
+
+from __future__ import annotations
+
+import json
+from pathlib import Path
+
+from . import hayes_holdings as hh
+from .hayes_rpc import ENA_ETHEREUM, make_fetch
+
+
+def _registered(config_path, chain: str, wallet: str) -> bool:
+    try:
+        raw = json.loads(Path(config_path).read_text(encoding="utf-8"))
+        ents = hh.normalize_entries((raw.get("hayes_holdings") or {}).get("entries") or [])
+    except Exception:  # noqa: BLE001 - 설정이 없거나 깨졌으면 미등록으로 본다
+        return False
+    return any(e["chain"] == chain and e["wallet"] == wallet for e in ents)
+
+
+def lookup(address: str, config_path="config.json", chain: str = "ethereum", rpc=None, rpc_urls=None) -> dict:
+    """저장 없이 주소 하나의 ENA 보유량을 조회한다. 잘못된 주소는 ValueError."""
+    chain = (chain or "ethereum").strip().lower()
+    wallet = hh.normalize_address(chain, address)
+    if rpc_urls is None:
+        try:
+            rpc_urls = hh.load_config(config_path)[0].rpc_urls
+        except Exception:  # noqa: BLE001
+            rpc_urls = {}
+    r = make_fetch(rpc_urls, rpc)("evm_rpc", {"chain": chain, "wallet": wallet, "contract": ENA_ETHEREUM}, {})
+    raw, dec = hh._int(r["balance"], "balance"), hh._int(r["decimals"], "decimals")
+    return {"ok": True, "chain": chain, "address": wallet, "balance": hh._fmt(raw, dec), "registered": _registered(config_path, chain, wallet)}
+
+
+def register(address: str, attribution_url: str, config_path="config.json", db_path=None, chain: str = "ethereum", rpc=None) -> dict:
+    """먼저 온체인으로 확인한 뒤 등록하고, 곧바로 한 번 수집해 카드가 갱신되게 한다."""
+    found = lookup(address, config_path, chain, rpc=rpc)
+    if found["registered"]:
+        raise ValueError("이미 등록된 주소다")
+    if not str(attribution_url).strip().startswith(("http://", "https://")):
+        raise ValueError("출처 URL은 http(s)로 시작해야 한다")
+    hh.add_entry(config_path, found["address"], str(attribution_url).strip(), chain)
+    cfg, data_dir = hh.load_config(config_path)
+    conn = hh.connect(db_path or cfg.db_path or Path(data_dir) / "hayes_holdings.sqlite")
+    fetch = make_fetch(cfg.rpc_urls, rpc)
+    res = hh.collect_once(conn, cfg, fetch=fetch)
+    return {**found, "registered": True, "collect": res["status"], "detail": res["detail"]}
diff --git a/tests/test_hayes_lookup.py b/tests/test_hayes_lookup.py
new file mode 100644
index 0000000..3bc4263
--- /dev/null
+++ b/tests/test_hayes_lookup.py
@@ -0,0 +1,82 @@
+import json
+import subprocess
+import sys
+from pathlib import Path
+
+import pytest
+from ena_bot import hayes_lookup as hl
+from ena_bot import hayes_holdings as hh
+from ena_bot.hayes_rpc import SEL_BALANCE_OF, SEL_DECIMALS, SEL_SYMBOL
+
+W1 = "0x" + "11" * 20
+
+
+def fake_rpc(balances=None):
+    balances = balances or {}
+
+    def rpc(url, method, params):
+        d = params[0]["data"]
+        if d == SEL_SYMBOL:
+            b = b"ENA"
+            return "0x" + (32).to_bytes(32, "big").hex() + len(b).to_bytes(32, "big").hex() + b.ljust(32, b"\0").hex()
+        if d == SEL_DECIMALS:
+            return hex(18)
+        assert d.startswith(SEL_BALANCE_OF)
+        return hex(balances.get("0x" + d[-40:], 0))
+    return rpc
+
+TOOL = Path(__file__).resolve().parents[1] / "tools" / "wire_hayes_lookup.py"
+
+
+def cfgfile(tmp_path):
+    p = tmp_path / "config.json"
+    p.write_text(json.dumps({"data_dir": str(tmp_path / "data")}))
+    return p
+
+
+def test_lookup_and_register(tmp_path):
+    p = cfgfile(tmp_path)
+    rpc = fake_rpc(balances={W1: 3 * 10**18})
+    j = hl.lookup(W1.upper().replace("0X", "0x"), p, rpc=rpc)
+    assert j["balance"] == "3.000000000000000000" and not j["registered"]
+    r = hl.register(W1, "https://x.example/a", p, tmp_path / "d.sqlite", rpc=rpc)
+    assert r["collect"] == "ok"
+    assert hl.lookup(W1, p, rpc=rpc)["registered"]
+    with pytest.raises(ValueError):
+        hl.register(W1, "https://x.example/a", p, tmp_path / "d.sqlite", rpc=rpc)
+
+
+def test_bad_input(tmp_path):
+    p = cfgfile(tmp_path)
+    with pytest.raises(ValueError):
+        hl.lookup("0x지갑주소", p)
+    with pytest.raises(ValueError):
+        hl.register(W1, "no-url", p, tmp_path / "d.sqlite", rpc=fake_rpc())
+
+
+def test_wire_tool_idempotent_and_safe(tmp_path):
+    (tmp_path / "ena_bot/dashboard_static").mkdir(parents=True)
+    fixture = (
+        "import json\nfrom urllib.parse import urlparse\nfrom .hayes_holdings import DEFAULT_INTERVAL_MIN\n"
+        "def make_handler(cfg):\n    class Handler:\n"
+        "        def do_GET(self):\n            try:\n"
+        "                if 0:\n                    pass\n"
+        '                elif url.path == "/healthz":\n                    pass\n'
+        "            except ValueError:\n                pass\n\n"
+        "        def log_message(self, fmt, *args) -> None:  # 요청 로그는 조용히\n            return\n"
+        "    return Handler\n")
+    (tmp_path / "ena_bot/dashboard.py").write_text(fixture)
+    (tmp_path / "ena_bot/dashboard_static/index.html").write_text("<body>\n  <!--HAYES_CARD-->\n</body>")
+    run = lambda: subprocess.run([sys.executable, str(TOOL), str(tmp_path)], capture_output=True, text=True)
+    r = run()
+    assert r.returncode == 0, r.stderr + r.stdout
+    d = (tmp_path / "ena_bot/dashboard.py").read_text()
+    assert "do_POST" in d and "/api/hayes-lookup" in d
+    compile(d, "d", "exec")
+    assert "이미 적용됨" in run().stdout
+    assert (tmp_path / "ena_bot/dashboard_static/index.html").read_text().count('id="hayes-lookup"') == 1
+    # 위치가 없으면 아무것도 바꾸지 않는다
+    (tmp_path / "ena_bot/dashboard_static/index.html").write_text("<body></body>")
+    (tmp_path / "ena_bot/dashboard.py").write_text("x = 1\n")
+    r = run()
+    assert r.returncode != 0 and (tmp_path / "ena_bot/dashboard.py").read_text() == "x = 1\n"
