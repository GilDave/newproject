@@ -0,0 +1,86 @@
+"""대시보드에 '주소 조회·등록' 버튼을 연결한다. 한 번만 실행(이미 적용됐으면 아무것도 안 함).
+사용: .venv/bin/python tools/wire_hayes_lookup.py [프로젝트 폴더]
+"""
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+dash = root / "ena_bot/dashboard.py"
+page = root / "ena_bot/dashboard_static/index.html"
+
+IMPORT_A = "from .hayes_holdings import DEFAULT_INTERVAL_MIN\n"
+IMPORT_B = IMPORT_A + "from . import hayes_lookup\n"
+
+GET_A = '                elif url.path == "/healthz":\n'
+GET_B = '''                elif url.path == "/api/hayes-lookup":
+                    self._json(hayes_lookup.lookup(q.get("address", ""), "config.json", q.get("chain", "ethereum")))
+''' + GET_A
+
+POST_A = "        def log_message(self, fmt, *args) -> None:  # 요청 로그는 조용히\n"
+POST_B = '''        def do_POST(self) -> None:  # noqa: N802
+            url = urlparse(self.path)
+            try:
+                if url.path != "/api/hayes-register":
+                    self._send(404, b"not found", "text/plain")
+                    return
+                if self.headers.get("X-Hayes") != "1":  # 다른 웹페이지가 몰래 호출하지 못하게
+                    self._json({"error": "허용되지 않은 요청"}, 403)
+                    return
+                body = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
+                self._json(hayes_lookup.register(str(body.get("address", "")), str(body.get("attribution_url", "")),
+                                                 "config.json", cfg.data_path / "hayes_holdings.sqlite"))
+            except (ValueError, KeyError) as exc:
+                self._json({"error": str(exc)}, 400)
+            except Exception as exc:  # noqa: BLE001
+                log.exception("hayes register failed")
+                self._json({"error": str(exc)}, 500)
+
+''' + POST_A
+
+MARK = "<!--HAYES_CARD-->"
+UI = MARK + '''
+  <details class="panel hayes-lookup" id="hayes-lookup">
+    <summary>온체인 주소 조회·등록 (ENA)</summary>
+    <div class="hl-row"><input id="hl-addr" placeholder="0x로 시작하는 지갑 주소" size="46" spellcheck="false"><button id="hl-go" type="button">조회</button></div>
+    <div class="hl-out" id="hl-out"></div>
+    <div class="hl-row" id="hl-reg" hidden><input id="hl-url" placeholder="출처 URL (예: Arkham 주소 페이지)" size="46"><button id="hl-add" type="button">등록</button></div>
+    <div class="hayes-note">직접 확인한 주소만 등록하세요. 보유량은 이더리움 온체인 ENA 직접 보유분입니다.</div>
+  </details>
+  <style>.hayes-lookup{margin-bottom:10px;padding:8px 12px;font-size:12px}.hayes-lookup summary{cursor:pointer;font-weight:600}.hl-row{display:flex;gap:6px;margin:6px 0}.hl-row[hidden]{display:none}.hl-row input{flex:1;min-width:0}.hl-out{font-weight:600;margin:4px 0;overflow-wrap:anywhere}.hl-out.err{color:var(--bad,#c33)}</style>
+  <script>(function(){
+    const g=id=>document.getElementById(id), out=g('hl-out'), reg=g('hl-reg'); let cur=null;
+    const show=(t,err)=>{out.textContent=t;out.className='hl-out'+(err?' err':'');};
+    g('hl-go').onclick=async()=>{reg.hidden=true;cur=null;const a=g('hl-addr').value.trim();show('조회 중…');
+      try{const r=await fetch('/api/hayes-lookup?address='+encodeURIComponent(a));const j=await r.json();
+        if(!r.ok){show(j.error||'조회 실패',true);return;}
+        cur=j.address;show(j.address+' → '+j.balance+' ENA'+(j.registered?' (이미 등록됨)':''));reg.hidden=!!j.registered;
+      }catch(e){show('조회 실패: '+e,true);}};
+    g('hl-add').onclick=async()=>{if(!cur)return;
+      try{const r=await fetch('/api/hayes-register',{method:'POST',headers:{'Content-Type':'application/json','X-Hayes':'1'},body:JSON.stringify({address:cur,attribution_url:g('hl-url').value.trim()})});
+        const j=await r.json();if(!r.ok){show(j.error||'등록 실패',true);return;}
+        show('등록 완료 · 수집 결과: '+j.collect+(j.detail?' ('+j.detail+')':''));reg.hidden=true;
+        const c=document.getElementById('hayes-card');const rc=await fetch('/api/hayes-card');if(c&&rc.ok)c.outerHTML=await rc.text();
+      }catch(e){show('등록 실패: '+e,true);}};
+  })();</script>'''
+
+
+def edit(path, a, b, done_marker):
+    s = path.read_text(encoding="utf-8")
+    if done_marker in s:
+        print("이미 적용됨:", path.name)
+        return
+    if s.count(a) != 1:
+        raise SystemExit(f"{path.name}: 연결할 위치를 찾지 못했습니다({s.count(a)}곳). 수정하지 않았습니다.")
+    path.write_text(s.replace(a, b, 1), encoding="utf-8")
+    print("수정:", path.name)
+
+
+# 두 파일 모두 위치를 먼저 확인한 뒤에만 수정한다
+ds, ps = dash.read_text(encoding="utf-8"), page.read_text(encoding="utf-8")
+for s, a, name in ((ds, IMPORT_A, "import"), (ds, GET_A, "GET"), (ds, POST_A, "POST"), (ps, MARK, "html")):
+    if s.count(a) != 1 and "hayes_lookup" not in s and "hayes-lookup" not in s:
+        raise SystemExit(f"{name} 위치를 찾지 못했습니다. 수정하지 않았습니다.")
+edit(dash, IMPORT_A, IMPORT_B, "from . import hayes_lookup")
+edit(dash, GET_A, GET_B, "/api/hayes-lookup")
+edit(dash, POST_A, POST_B, "do_POST")
+edit(page, MARK, UI, 'id="hayes-lookup"')
