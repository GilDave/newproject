@@ -0,0 +1,64 @@
+from types import SimpleNamespace
+
+import numpy as np
+
+from ena_bot import shock_study as ss
+
+H = 3_600_000
+
+
+def hourly(seed, n=4000, at=(2000, 2400, 2800, 3200), up=0.30, drift=-0.004, back=40):
+    rng = np.random.default_rng(seed)
+    r = rng.normal(0, 0.004, n)
+    for i in at:
+        r[i + 1] = up                                    # 4시간 칸 안의 한 시간에서 튄다
+        r[i + 2:i + 2 + back] = drift                    # 이후 40시간 동안 되돌린다
+    c = 0.5 * np.exp(np.cumsum(r))
+    o = np.concatenate([[0.5], c[:-1]])
+    sp = np.abs(rng.normal(0, 0.003, n))
+    h = np.maximum(o, c) * np.exp(sp)
+    l = np.minimum(o, c) * np.exp(-sp)
+    return SimpleNamespace(ts=np.arange(n, dtype=np.int64) * H, open=o, high=h, low=l, close=c, volume=np.exp(rng.normal(8, 0.3, n)))
+
+
+def test_resample_groups_complete_buckets_only():
+    ts = np.arange(10) * H
+    o = np.arange(10) + 1.0
+    h, l, c, v = o + 0.5, o - 0.5, o + 0.25, np.ones(10)
+    t4, o4, h4, l4, c4, v4 = ss.resample_ohlcv(ts, o, h, l, c, v, 4)
+    assert list(t4) == [0, 4 * H] and list(o4) == [1.0, 5.0] and list(h4) == [4.5, 8.5] and list(l4) == [0.5, 4.5]
+    assert list(c4) == [4.25, 8.25] and list(v4) == [4.0, 4.0]               # 마지막 불완전한 칸(8,9번 시각)은 버린다
+    assert len(ss.resample_ohlcv(ts, o, h, l, c, v, 1)[0]) == 10
+
+
+def test_study_over_a_pool_reports_reversals_and_renders_the_verdict():
+    pool = {f"C{k}": hourly(k) for k in range(1, 10)}
+    res = ss.run(pool, 4, recent_symbol="C1")
+    assert len(res["coins"]) == 9 and res["study"]["events"] >= 36          # 주입한 36개 + 무작위 꼬리에서 우연히 잡히는 것이 있을 수 있다
+    s6 = res["study"]["horizons"][6]
+    assert s6["n"] >= 36 and s6["mean"] < -0.05 and s6["continue_rate"] < 0.1
+    assert res["verdicts"][6]["use"] is True and "되돌리는" in res["verdicts"][6]["why"]
+    assert len(res["recent"]) >= 4 and all(r["kind"] == "body_run" for r in res["recent"])
+    text = ss.render(res)
+    assert "독립 사건" in text and "되돌리는" in text and "최근 이상 변동 봉" in text and "원인 미확인" in text
+
+
+def test_a_short_history_or_too_few_coins_is_never_used():
+    res = ss.run({"ENAUSDT": hourly(1, at=(3000,))}, 4)
+    assert not res["verdicts"][6]["use"] and "표본 부족" in res["verdicts"][6]["why"]
+    tiny = SimpleNamespace(ts=np.arange(100) * H, open=np.ones(100), high=np.ones(100), low=np.ones(100), close=np.ones(100), volume=np.ones(100))
+    assert ss.run({"X": tiny}, 4)["coins"] == []                                # 이력이 짧은 코인은 건너뛴다
+    assert "표본 부족" in ss.render(ss.run({"X": tiny}, 4))
+
+
+def test_candles_in_a_bars_matrix_are_read_by_checking_the_column_order():
+    import pytest
+    c = hourly(1)
+    real_ts = c.ts + 1_700_000_000_000                                                                  # 실제 데이터처럼 에포크 밀리초
+    bars = np.column_stack([real_ts, c.open, c.high, c.low, c.close, c.volume, np.zeros(len(c.ts))])   # [ts, o, h, l, c, v, 기타]
+    ts, o, h, l, cl, v = ss.coin_arrays(SimpleNamespace(bars=bars))
+    assert np.array_equal(ts, real_ts) and np.array_equal(h, c.high) and np.array_equal(v, c.volume)
+    assert ss.run({"X": SimpleNamespace(bars=bars)}, 4)["coins"] == ["X"]
+    swapped = np.column_stack([real_ts, c.open, c.low, c.high, c.close, c.volume])                         # 고가·저가 열이 바뀐 배열은 믿지 않는다
+    with pytest.raises(ValueError, match="CoinData"):
+        ss.coin_arrays(SimpleNamespace(bars=swapped))
diff --git a/tools/shock_chart.js b/tools/shock_chart.js
new file mode 100644
index 0000000..f2ca626
--- /dev/null
+++ b/tools/shock_chart.js
@@ -0,0 +1,51 @@
+// ---- 이상 변동 봉 표시: ena_bot/shock.py 와 같은 규칙(직전 180봉의 변동폭·몸통 대비 6배 이상, 최소 범위 3%). 원인은 추정하지 않는다. ----
+const SHK = {win: 180, z: 6, minRange: 0.03, wick: 0.6, mad: 1.4826};
+function shkMid(s) { const n = s.length; return n % 2 ? s[(n - 1) / 2] : (s[n / 2 - 1] + s[n / 2]) / 2; }
+function shkMedMad(x, i, w) {          // 직전 w개(i 자신은 제외)의 중앙값과 절대편차 중앙값: 미래를 쓰지 않는다
+  const s = x.slice(i - w, i).sort((a, b) => a - b), med = shkMid(s);
+  const d = s.map(v => Math.abs(v - med)).sort((a, b) => a - b);
+  return [med, shkMid(d)];
+}
+function shkScale(med, mad, rel) { return Math.max(SHK.mad * mad, rel * Math.abs(med), 1e-9); }
+function detectShocks(b) {
+  const n = b.length, out = [];
+  const rng = b.map(x => Math.log(Math.max(x.high, 1e-12) / Math.max(x.low, 1e-12)));
+  const body = b.map(x => Math.abs(Math.log(Math.max(x.close, 1e-12) / Math.max(x.open, 1e-12))));
+  const vol = b.map(x => Math.log1p(Math.max(x.volume || 0, 0)));
+  for (let i = SHK.win; i < n; i++) {
+    if (!(rng[i] >= SHK.minRange)) continue;                       // 대부분의 봉은 여기서 건너뛴다(범위 3% 미만)
+    const [mr, dr] = shkMedMad(rng, i, SHK.win), [mb, db] = shkMedMad(body, i, SHK.win);
+    const zr = (rng[i] - mr) / shkScale(mr, dr, 0.25), zb = (body[i] - mb) / shkScale(mb, db, 0.25);
+    if (!(zr >= SHK.z || zb >= SHK.z)) continue;
+    const x = b[i], full = x.high - x.low;
+    const upper = full > 0 ? (x.high - Math.max(x.open, x.close)) / full : 0, lower = full > 0 ? (Math.min(x.open, x.close) - x.low) / full : 0;
+    let zv = null;
+    if (b.some(y => y.volume > 0)) { const [mv, dv] = shkMedMad(vol, i, SHK.win); zv = (vol[i] - mv) / shkScale(mv, dv, 0); }
+    const ev = {i, time: x.time, direction: x.close >= x.open ? 'up' : 'down', ret: x.close / x.open - 1, rangePct: Math.expm1(rng[i]),
+      zRange: zr, zBody: zb, zVolume: zv, upper, lower, kind: Math.max(upper, lower) >= SHK.wick ? 'wick_spike' : 'body_run'};
+    if (out.length && ev.i - out[out.length - 1].i <= 1) { if (ev.zRange > out[out.length - 1].zRange) out[out.length - 1] = ev; continue; }   // 이어진 봉은 하나의 사건
+    out.push(ev);
+  }
+  return out;
+}
+function shockText(e) {
+  const sgn = e.ret >= 0 ? '+' : '-', pct = sgn + Math.round(Math.abs(e.ret) * 100) + '%';
+  let t = (e.kind === 'wick_spike' ? '꼬리 급등락' : e.direction === 'up' ? '장대 양봉' : '장대 음봉') + ' ' + pct + ' · 평소 변동폭의 ' + Math.round(1 + e.zRange) + '배 수준';
+  if (e.zVolume != null && e.zVolume >= 3) t += ' · 거래량도 급증';
+  if (e.kind === 'wick_spike') t += ' · 체결·데이터 오류 가능성 확인 필요';
+  return t + ' · 원인 미확인';
+}
+let SHK_KEY = '', SHK_CACHE = [];
+function shockEvents() {               // 화면의 봉이 바뀔 때만 다시 계산한다
+  const L = bars.length, k = L + ':' + (L ? bars[0].time + ':' + bars[L - 1].time + ':' + bars[L - 1].close + ':' + bars[L - 1].high + ':' + bars[L - 1].low : '');
+  if (k !== SHK_KEY) { SHK_KEY = k; SHK_CACHE = detectShocks(bars); }
+  return SHK_CACHE;
+}
+function shockMarkers() {
+  return shockEvents().map(e => ({time: e.time, position: e.direction === 'up' ? 'aboveBar' : 'belowBar', color: '#f5b942', shape: 'circle',
+    text: '⚡' + (e.ret >= 0 ? '+' : '-') + Math.round(Math.abs(e.ret) * 100) + '%'}));
+}
+function shockTip(t) {
+  const e = t == null ? null : shockEvents().find(x => x.time === t);
+  return e ? '<div style="margin-top:4px"><b>⚡ ' + shockText(e) + '</b></div>' : '';
+}
