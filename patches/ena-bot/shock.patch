@@ -0,0 +1,137 @@
+"""18개 코인 학습 캐시로 '이상 변동 봉 뒤에 가격이 어떻게 움직였는지'를 통계로 확인한다. 읽기 전용이며 매매·모델에 영향이 없다.
+
+실행: python -m ena_bot.shock_study [--config config.json] [--factor 4] [--symbols ADAUSDT,...]
+결과는 화면에 출력하고 <data_dir>/shock_study.json 에 저장한다. 기준(독립 사건 30개·코인 5개 이상, 신뢰구간이 0을 포함하지 않음)을 넘지 못하면
+'반영하지 않음'이라고 나온다 — 한 번의 사건으로 규칙을 만들지 않는다.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+
+from . import shock
+
+HORIZONS = (1, 6, 18, 42)
+
+
+def resample_ohlcv(ts, o, h, l, c, v, factor: int):
+    """1시간봉(등) → factor배 봉. 시각을 factor×봉 길이로 나눈 칸마다 묶고, 다 차지 않은 마지막 칸은 버린다."""
+    ts = np.asarray(ts, dtype=np.int64)
+    if factor <= 1 or len(ts) < 2:
+        return ts, *(np.asarray(a, dtype=float) for a in (o, h, l, c, v))
+    bar = int(np.median(np.diff(ts)))
+    key = ts // (bar * factor)
+    uniq, first, count = np.unique(key, return_index=True, return_counts=True)
+    full = count == factor
+    o, h, l, c, v = (np.asarray(a, dtype=float) for a in (o, h, l, c, v))
+    out_ts, oo, hh, ll, cc, vv = [], [], [], [], [], []
+    for f, k in zip(first[full], count[full]):
+        sl = slice(f, f + k)
+        out_ts.append(ts[f])
+        oo.append(o[f]); hh.append(h[sl].max()); ll.append(l[sl].min()); cc.append(c[f + k - 1]); vv.append(v[sl].sum())
+    return np.array(out_ts), np.array(oo), np.array(hh), np.array(ll), np.array(cc), np.array(vv)
+
+
+def _ohlc_ok(a: np.ndarray, cols: tuple[int, int, int, int]) -> bool:
+    o, h, l, c = (a[:, k] for k in cols)
+    return bool(np.mean((l <= np.minimum(o, c) * (1 + 1e-9)) & (np.maximum(o, c) <= h * (1 + 1e-9)) & (h > 0)) > 0.99)
+
+
+def coin_arrays(coin):
+    """(ts, open, high, low, close, volume). 개별 배열 속성이 있으면 그대로, 없으면 `bars` 2차원 배열의 열 순서를 시가·고가·저가·종가의 관계로 확인해서 읽는다.
+    확인이 안 되면 추측하지 않고 ValueError."""
+    if all(hasattr(coin, k) for k in ("ts", "open", "high", "low", "close", "volume")):
+        return coin.ts, coin.open, coin.high, coin.low, coin.close, coin.volume
+    a = np.asarray(getattr(coin, "bars", None), dtype=float)
+    if a.ndim == 2 and a.shape[1] >= 6 and len(a) > 10:
+        a = a[~np.isnan(a[:, :6]).any(axis=1)]
+        if a[:, 0].min() > 1e11 and _ohlc_ok(a, (1, 2, 3, 4)):      # [ts, open, high, low, close, volume, ...]
+            return a[:, 0].astype(np.int64), a[:, 1], a[:, 2], a[:, 3], a[:, 4], a[:, 5]
+    raise ValueError(f"캔들 배열의 열 순서를 확인하지 못했습니다(type={type(coin).__name__}, bars shape={getattr(a, 'shape', None)}). "
+                     "ena_bot/featx.py 의 CoinData 정의를 알려 주세요.")
+
+
+def run(pool: dict, factor: int = 4, horizons=HORIZONS, recent_symbol: str | None = None) -> dict:
+    """pool: {심볼: ts·open·high·low·close·volume 배열을 가진 객체}. 통계와 반영 여부 판정을 돌려준다."""
+    per = {}
+    series = {}
+    for sym, coin in pool.items():
+        ts, o, h, l, c, v = resample_ohlcv(*coin_arrays(coin), factor)
+        if len(c) < 400:
+            continue
+        per[sym] = (o, h, l, c, v, ts)
+        series[sym] = ts
+    study = shock.event_study(per, horizons)
+    verdicts = {h: shock.verdict(study, h) for h in horizons}
+    recent = []
+    sym = recent_symbol if recent_symbol in per else None
+    if sym:
+        o, h_, l, c, v = per[sym][:5]
+        for ev in shock.detect_shocks(o, h_, l, c, v)[-10:]:
+            recent.append({"ts": int(series[sym][ev["i"]]), "text": shock.describe(ev), "ret": ev["ret"], "kind": ev["kind"]})
+    return {"factor": factor, "coins": sorted(per), "study": study, "verdicts": verdicts, "recent": recent, "generated": int(time.time())}
+
+
+def render(res: dict) -> str:
+    st = res["study"]
+    lines = [f"이상 변동 봉 사후 통계 — {res['factor']}배 봉 · 코인 {len(res['coins'])}개 · 사건 {st['events']}개(코인 {st['coins_with_events']}개에서 발생)", ""]
+    conf = (1 - st["alpha"]) * 100
+    lines.append(f"봉 수 | 사건 | 서로 다른 날 | 평균 | 중앙값 | 충격 방향 지속 비율 | {conf:.2f}% 신뢰구간(날 단위 묶음·다중 비교 보정) | 판정")
+    for h, s in st["horizons"].items():
+        if not s["n"]:
+            lines.append(f"{h:>4} | 0 | 0 | - | - | - | - | {res['verdicts'][h]['why']}")
+            continue
+        lines.append(f"{h:>4} | {s['n']:>4} | {s['n_clusters']:>4} | {s['mean']:+.2%} | {s['median']:+.2%} | {s['continue_rate']:.0%} | {s['ci'][0]:+.2%} ~ {s['ci'][1]:+.2%} | {res['verdicts'][h]['why']}")
+    lines += ["", "(+ = 충격 방향으로 이어짐, - = 되돌림. 같은 날 여러 코인에서 생긴 사건은 한 묶음으로 계산합니다. 기준: 서로 다른 날 %d개·코인 %d개 이상이고 "
+              "보정한 신뢰구간이 0을 포함하지 않을 때만 반영. 수수료·슬리피지 차감 전 수치이고, 상장 이력이 긴 코인만 있어 생존 편향이 있을 수 있습니다.)" % (shock.MIN_EVENTS, shock.MIN_COINS)]
+    if res["recent"]:
+        lines += ["", "최근 이상 변동 봉:"] + [f"  {time.strftime('%Y-%m-%d %H:%M', time.gmtime(r['ts'] / 1000))} UTC  {r['text']}" for r in res["recent"]]
+    return "\n".join(lines)
+
+
+def load_saved(data_path) -> dict:
+    """대시보드가 읽는 요약: 저장된 shock_study.json 에서 화면에 필요한 것만. 없거나 깨졌으면 {"ok": False}."""
+    try:
+        d = json.loads((Path(data_path) / "shock_study.json").read_text(encoding="utf-8"))
+        st = d.get("study") or {}
+        horizons = {str(h): {k: s.get(k) for k in ("n", "n_clusters", "n_coins", "mean", "median", "continue_rate", "ci")} for h, s in (st.get("horizons") or {}).items()}
+        verdicts = {str(h): {"use": bool(v.get("use")), "why": str(v.get("why", ""))} for h, v in (d.get("verdicts") or {}).items()}
+        age = (time.time() - float(d.get("generated", 0))) / 86400
+    except (OSError, ValueError, TypeError, AttributeError):
+        return {"ok": False}
+    return {"ok": True, "factor": d.get("factor"), "coins": len(d.get("coins") or []), "events": st.get("events"), "horizons": horizons, "verdicts": verdicts,
+            "alpha": st.get("alpha"), "age_days": round(age, 1)}
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .config import load_config
+    from .learn_data import DEFAULT_SYMBOLS, load_coin
+
+    ap = argparse.ArgumentParser(description="이상 변동 봉 사후 통계(읽기 전용)")
+    ap.add_argument("--config", default="config.json")
+    ap.add_argument("--factor", type=int, default=4, help="1시간봉을 몇 배로 묶을지(기본 4 = 4시간봉)")
+    ap.add_argument("--symbols", default="")
+    ap.add_argument("--recent", default="ENAUSDT", help="최근 이상 봉을 보여줄 코인")
+    args = ap.parse_args(argv)
+    cfg = load_config(args.config)
+    cache = cfg.data_path / "learn_cache"
+    symbols = [x.strip() for x in args.symbols.split(",") if x.strip()] or DEFAULT_SYMBOLS
+    pool = {s: c for s in symbols if (c := load_coin(s, cache)) is not None}
+    if not pool:
+        print(f"학습 캐시가 없습니다: {cache}  (먼저 learn-train 으로 데이터를 받으세요)")
+        return 2
+    res = run(pool, args.factor, recent_symbol=args.recent)
+    print(render(res))
+    out = cfg.data_path / "shock_study.json"
+    out.write_text(json.dumps(res, ensure_ascii=False, indent=2, default=lambda o: o.item() if hasattr(o, "item") else str(o)), encoding="utf-8")
+    print(f"\n저장: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
