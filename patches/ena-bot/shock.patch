--- /dev/null
+++ b/ena_bot/shock_study.py
@@ -0,0 +1,121 @@
+"""18개 코인 학습 캐시로 '이상 변동 봉 뒤에 가격이 어떻게 움직였는지'를 통계로 확인한다. 읽기 전용이며 매매·모델에 영향이 없다.
+
+실행: python -m ena_bot.shock_study [--config config.json] [--factor 4] [--symbols ADAUSDT,...]
+결과는 화면에 출력하고 <data_dir>/shock_study.json 에 저장한다. 기준(독립 사건 30개·코인 5개 이상, 신뢰구간이 0을 포함하지 않음)을 넘지 못하면
+'반영하지 않음'이라고 나온다 — 한 번의 사건으로 규칙을 만들지 않는다.
+"""
+
+from __future__ import annotations
+
+import argparse
+import json
+import time
+from pathlib import Path
+
+import numpy as np
+
+from . import shock
+
+HORIZONS = (1, 6, 18, 42)
+
+
+def resample_ohlcv(ts, o, h, l, c, v, factor: int):
+    """1시간봉(등) → factor배 봉. 시각을 factor×봉 길이로 나눈 칸마다 묶고, 다 차지 않은 마지막 칸은 버린다."""
+    ts = np.asarray(ts, dtype=np.int64)
+    if factor <= 1 or len(ts) < 2:
+        return ts, *(np.asarray(a, dtype=float) for a in (o, h, l, c, v))
+    bar = int(np.median(np.diff(ts)))
+    key = ts // (bar * factor)
+    uniq, first, count = np.unique(key, return_index=True, return_counts=True)
+    full = count == factor
+    o, h, l, c, v = (np.asarray(a, dtype=float) for a in (o, h, l, c, v))
+    out_ts, oo, hh, ll, cc, vv = [], [], [], [], [], []
+    for f, k in zip(first[full], count[full]):
+        sl = slice(f, f + k)
+        out_ts.append(ts[f])
+        oo.append(o[f]); hh.append(h[sl].max()); ll.append(l[sl].min()); cc.append(c[f + k - 1]); vv.append(v[sl].sum())
+    return np.array(out_ts), np.array(oo), np.array(hh), np.array(ll), np.array(cc), np.array(vv)
+
+
+def _ohlc_ok(a: np.ndarray, cols: tuple[int, int, int, int]) -> bool:
+    o, h, l, c = (a[:, k] for k in cols)
+    return bool(np.mean((l <= np.minimum(o, c) * (1 + 1e-9)) & (np.maximum(o, c) <= h * (1 + 1e-9)) & (h > 0)) > 0.99)
+
+
+def coin_arrays(coin):
+    """(ts, open, high, low, close, volume). 개별 배열 속성이 있으면 그대로, 없으면 `bars` 2차원 배열의 열 순서를 시가·고가·저가·종가의 관계로 확인해서 읽는다.
+    확인이 안 되면 추측하지 않고 ValueError."""
+    if all(hasattr(coin, k) for k in ("ts", "open", "high", "low", "close", "volume")):
+        return coin.ts, coin.open, coin.high, coin.low, coin.close, coin.volume
+    a = np.asarray(getattr(coin, "bars", None), dtype=float)
+    if a.ndim == 2 and a.shape[1] >= 6 and len(a) > 10:
+        a = a[~np.isnan(a[:, :6]).any(axis=1)]
+        if a[:, 0].min() > 1e11 and _ohlc_ok(a, (1, 2, 3, 4)):      # [ts, open, high, low, close, volume, ...]
+            return a[:, 0].astype(np.int64), a[:, 1], a[:, 2], a[:, 3], a[:, 4], a[:, 5]
+    raise ValueError(f"캔들 배열의 열 순서를 확인하지 못했습니다(type={type(coin).__name__}, bars shape={getattr(a, 'shape', None)}). "
+                     "ena_bot/featx.py 의 CoinData 정의를 알려 주세요.")
+
+
+def run(pool: dict, factor: int = 4, horizons=HORIZONS, recent_symbol: str | None = None) -> dict:
+    """pool: {심볼: ts·open·high·low·close·volume 배열을 가진 객체}. 통계와 반영 여부 판정을 돌려준다."""
+    per = {}
+    series = {}
+    for sym, coin in pool.items():
+        ts, o, h, l, c, v = resample_ohlcv(*coin_arrays(coin), factor)
+        if len(c) < 400:
+            continue
+        per[sym] = (o, h, l, c, v)
+        series[sym] = ts
+    study = shock.event_study(per, horizons)
+    verdicts = {h: shock.verdict(study, h) for h in horizons}
+    recent = []
+    sym = recent_symbol if recent_symbol in per else None
+    if sym:
+        o, h_, l, c, v = per[sym]
+        for ev in shock.detect_shocks(o, h_, l, c, v)[-10:]:
+            recent.append({"ts": int(series[sym][ev["i"]]), "text": shock.describe(ev), "ret": ev["ret"], "kind": ev["kind"]})
+    return {"factor": factor, "coins": sorted(per), "study": study, "verdicts": verdicts, "recent": recent, "generated": int(time.time())}
+
+
+def render(res: dict) -> str:
+    st = res["study"]
+    lines = [f"이상 변동 봉 사후 통계 — {res['factor']}배 봉 · 코인 {len(res['coins'])}개 · 사건 {st['events']}개(코인 {st['coins_with_events']}개에서 발생)", ""]
+    lines.append("봉 수 | 독립 사건 | 평균 | 중앙값 | 충격 방향 지속 비율 | 95% 신뢰구간 | 판정")
+    for h, s in st["horizons"].items():
+        if not s["n"]:
+            lines.append(f"{h:>4} | 0 | - | - | - | - | {res['verdicts'][h]['why']}")
+            continue
+        lines.append(f"{h:>4} | {s['n']:>4} | {s['mean']:+.2%} | {s['median']:+.2%} | {s['continue_rate']:.0%} | {s['ci'][0]:+.2%} ~ {s['ci'][1]:+.2%} | {res['verdicts'][h]['why']}")
+    lines += ["", "(+ = 충격 방향으로 이어짐, - = 되돌림. 기준: 독립 사건 %d개·코인 %d개 이상이고 신뢰구간이 0을 포함하지 않을 때만 반영)" % (shock.MIN_EVENTS, shock.MIN_COINS)]
+    if res["recent"]:
+        lines += ["", "최근 이상 변동 봉:"] + [f"  {time.strftime('%Y-%m-%d %H:%M', time.gmtime(r['ts'] / 1000))} UTC  {r['text']}" for r in res["recent"]]
+    return "\n".join(lines)
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .config import load_config
+    from .learn_data import DEFAULT_SYMBOLS, load_coin
+
+    ap = argparse.ArgumentParser(description="이상 변동 봉 사후 통계(읽기 전용)")
+    ap.add_argument("--config", default="config.json")
+    ap.add_argument("--factor", type=int, default=4, help="1시간봉을 몇 배로 묶을지(기본 4 = 4시간봉)")
+    ap.add_argument("--symbols", default="")
+    ap.add_argument("--recent", default="ENAUSDT", help="최근 이상 봉을 보여줄 코인")
+    args = ap.parse_args(argv)
+    cfg = load_config(args.config)
+    cache = cfg.data_path / "learn_cache"
+    symbols = [x.strip() for x in args.symbols.split(",") if x.strip()] or DEFAULT_SYMBOLS
+    pool = {s: c for s in symbols if (c := load_coin(s, cache)) is not None}
+    if not pool:
+        print(f"학습 캐시가 없습니다: {cache}  (먼저 learn-train 으로 데이터를 받으세요)")
+        return 2
+    res = run(pool, args.factor, recent_symbol=args.recent)
+    print(render(res))
+    out = cfg.data_path / "shock_study.json"
+    out.write_text(json.dumps(res, ensure_ascii=False, indent=2, default=lambda o: o.item() if hasattr(o, "item") else str(o)), encoding="utf-8")
+    print(f"\n저장: {out}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
diff --git a/tests/test_shock.py b/tests/test_shock.py
new file mode 100644
index 0000000..62cf248
--- /dev/null
+++ b/tests/test_shock.py
@@ -0,0 +1,144 @@
+import json
+import math
+
+import numpy as np
+import pytest
+
+from ena_bot import shock as sk
+
+
+def series(r, seed=0, vol=0.004, v=False):
+    """로그수익률 r로 만든 OHLC(+거래량). 꼬리 폭은 평소 변동에 비례."""
+    rng = np.random.default_rng(seed + 1000)
+    c = 0.5 * np.exp(np.cumsum(r))
+    o = np.concatenate([[0.5], c[:-1]])
+    spread = np.abs(rng.normal(0, vol, len(r))) * 0.8
+    h = np.maximum(o, c) * np.exp(spread)
+    l = np.minimum(o, c) * np.exp(-spread)
+    vol_arr = np.exp(rng.normal(8, 0.3, len(r))) if v else None
+    return (o, h, l, c, vol_arr) if v else (o, h, l, c)
+
+
+def walk(n=600, seed=1, vol=0.004):
+    return np.random.default_rng(seed).normal(0, vol, n)
+
+
+def test_a_giant_green_candle_is_found_and_ordinary_bars_are_not():
+    for seed in range(1, 6):                                            # 평범한 구간에서는 오탐이 없다
+        assert sk.detect_shocks(*series(walk(seed=seed), seed)[:4]) == []
+    r = walk()
+    r[400] = math.log(1.34)                                             # 하루 만에 +34%
+    o, h, l, c = series(r)
+    h[400] = c[400] * 1.005
+    (ev,) = sk.detect_shocks(o, h, l, c)
+    assert ev["i"] == 400 and ev["direction"] == "up" and ev["kind"] == "body_run" and ev["ret"] == pytest.approx(0.34, abs=0.01)
+    assert ev["z_range"] > 20 and ev["upper_wick"] < 0.05
+
+
+def test_a_wick_spike_is_labelled_as_such_and_volume_is_used_when_given():
+    r = walk()
+    o, h, l, c, v = series(r, v=True)
+    h[300] = o[300] * 1.5                                               # 몸통은 평범한데 꼬리만 튐
+    v[300] *= 40
+    (ev,) = sk.detect_shocks(o, h, l, c, v)
+    assert ev["i"] == 300 and ev["kind"] == "wick_spike" and ev["z_volume"] > 5
+    assert "체결·데이터 오류" in sk.describe(ev)
+
+
+def test_detection_never_uses_future_bars():
+    r = walk()
+    r[400] = math.log(1.3)
+    full = series(r)
+    cut = [a[:401] for a in full]
+    a = sk.detect_shocks(*full)[0]
+    b = sk.detect_shocks(*cut)[0]
+    assert a["i"] == b["i"] == 400 and a["z_range"] == b["z_range"] and a["z_body"] == b["z_body"]
+    full2 = [x.copy() for x in full]
+    for arr in full2:
+        arr[402:] *= 3.0                                                # 이후 가격을 바꿔도 400번 봉의 판정은 같다
+    assert sk.detect_shocks(*full2)[0]["z_range"] == a["z_range"]
+
+
+def test_adjacent_shock_bars_are_one_event_and_tiny_ranges_are_ignored():
+    r = walk()
+    r[400], r[401] = math.log(1.25), math.log(1.10)
+    evs = sk.detect_shocks(*series(r))
+    assert [e["i"] for e in evs] == [400]
+    quiet = np.full(400, 1e-5)
+    quiet[350] = 0.004                                                  # 거의 무변동 구간에서의 작은 움직임: z는 크지만 범위가 3% 미만
+    assert sk.detect_shocks(*series(quiet, vol=1e-5)) == []
+
+
+def test_winsorizing_tames_the_shock_but_leaves_other_bars_and_the_raw_chart_alone():
+    r = walk()
+    r[400] = math.log(1.34)
+    o, h, l, c = series(r)
+    shocks = sk.detect_shocks(o, h, l, c)
+    o2, h2, l2, c2 = sk.winsorize_bars(o, h, l, c, shocks)
+    before = np.log(h / l)
+    after = np.log(h2 / l2)
+    assert after[400] < before[400] / 5 and c2[400] > o2[400] and h2[400] >= c2[400] >= l2[400]
+    mask = np.ones(len(c), bool)
+    mask[400] = False
+    assert np.array_equal(h2[mask], h[mask]) and np.array_equal(c2[mask], c[mask])
+    assert c[400] == pytest.approx(o[400] * 1.34)                       # 원본은 그대로
+    assert after.std() < before.std() / 2                               # 변동성이 봉 하나에 끌려가지 않는다
+
+
+def injected(seed, n=900, at=(250, 400, 550, 700), up=0.29, drift=-0.015, back=6):
+    r = walk(n, seed)
+    for i in at:
+        r[i] = up
+        r[i + 1:i + 1 + back] = drift
+    return series(r, seed)
+
+
+def test_forward_returns_are_direction_normalised_and_events_are_spaced():
+    o, h, l, c = injected(1)
+    shocks = sk.detect_shocks(o, h, l, c)
+    assert [e["i"] for e in shocks] == [250, 400, 550, 700]
+    fr = sk.forward_returns(c, shocks, (1, 6))
+    assert len(fr[6]) == 4 and all(x < -0.05 for x in fr[6])            # 오른 뒤 되돌림 → 충격 방향 기준 음수
+    down = injected(2, up=-0.29, drift=+0.015)
+    ds = sk.detect_shocks(*down)
+    assert all(e["direction"] == "down" for e in ds)
+    assert all(x < -0.05 for x in sk.forward_returns(down[3], ds, (6,))[6])   # 내린 뒤 되돌림도 같은 부호
+    close = [{"i": 100, "direction": "up"}, {"i": 105, "direction": "up"}, {"i": 130, "direction": "up"}]
+    assert len(sk.forward_returns(c, close, (1,), min_gap=12)[1]) == 2        # 12봉 안의 사건은 하나만
+
+
+def test_one_event_is_never_enough_but_many_independent_reversals_are():
+    single = sk.event_study({"COIN": injected(1, at=(400,))}, (6,))
+    v = sk.verdict(single, 6)
+    assert not v["use"] and "표본 부족" in v["why"]
+    many = {f"C{k}": injected(k) for k in range(1, 10)}                 # 9코인 × 4사건 = 36개
+    study = sk.event_study(many, (1, 6, 18))
+    assert study["events"] == 36 and study["horizons"][6]["n"] == 36 and study["horizons"][6]["n_coins"] == 9
+    v = sk.verdict(study, 6)
+    assert v["use"] and "되돌리는" in v["why"] and study["horizons"][6]["continue_rate"] == 0.0
+    noise = {f"N{k}": injected(k, drift=0.0) for k in range(1, 10)}     # 이후 움직임이 평범하면 결론을 내리지 않는다
+    nv = sk.verdict(sk.event_study(noise, (6,)), 6)
+    assert not nv["use"] and "불분명" in nv["why"]
+
+
+def test_notes_are_shown_but_always_unverified_and_never_change_the_detection(tmp_path):
+    r = walk()
+    r[400] = math.log(1.34)
+    o, h, l, c = series(r)
+    ts = np.arange(len(c)) * 4 * 3600_000
+    shocks = sk.detect_shocks(o, h, l, c)
+    plain = sk.shock_markers(ts, shocks)
+    assert "원인 미확인" in plain[0]["text"] and plain[0]["direction"] == "up"
+    store = sk.NoteStore(tmp_path / "notes.json")
+    row = store.add(int(ts[400]) + 1000, "엔비디아 관련 소문", "https://example.com/x", now=5)
+    assert row["verified"] is False
+    marked = sk.shock_markers(ts, shocks, store.load())
+    assert "사용자 메모(미검증): 엔비디아 관련 소문" in marked[0]["text"]
+    assert sk.detect_shocks(o, h, l, c) == shocks                       # 메모는 계산에 영향이 없다
+    for bad in (("", ""), ("x" * 201, ""), ("ok", "ftp://x")):
+        with pytest.raises(ValueError):
+            store.add(1, *bad)
+    store.add(int(ts[400]) + 1000, "수정한 메모")
+    assert [n["note"] for n in store.load()] == ["수정한 메모"]
+    (tmp_path / "notes.json").write_text("{broken")
+    assert store.load() == []
