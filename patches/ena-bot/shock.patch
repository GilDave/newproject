+"""충격 봉 툴팁에 '과거 통계' 한 줄을 연결한다(wire_shock_chart.py 를 먼저 적용). dashboard.py 2곳 + index.html 2곳.
+여러 번 실행해도 안전하고, 위치를 하나라도 못 찾으면 아무 파일도 바꾸지 않는다.
+사용: .venv/bin/python tools/wire_shock_stats.py [프로젝트 폴더]
+"""
+import sys
+from pathlib import Path
