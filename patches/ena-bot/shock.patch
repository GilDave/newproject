@@ -0,0 +1,17 @@
+// ---- 충격 봉 툴팁의 '과거 통계' 한 줄: 저장된 사후 통계(shock_study.json)가 반영 기준을 넘은 지평만 보여 준다. 4시간봉 차트에서만 ----
+let SHK_STATS = null;
+fetch('/api/shock-study').then(r => r.ok ? r.json() : null).then(j => { SHK_STATS = j && j.ok ? j : null; }).catch(() => {});
+function shockStatsLine() {
+  if (!SHK_STATS || !SHK_STATS.ok || !SHK_STATS.verdicts || !SHK_STATS.horizons || (typeof apiIv === 'function' && apiIv() !== '240')) return '';
+  const parts = [];
+  let sample = 0;
+  for (const h of ['1', '6']) {
+    const v = SHK_STATS.verdicts[h], s = SHK_STATS.horizons[h];
+    if (v && v.use && s && s.mean != null) { parts.push(h + '봉 뒤 평균 ' + (s.mean >= 0 ? '+' : '') + (s.mean * 100).toFixed(1) + '%'); sample = sample ? Math.min(sample, s.n_clusters || 0) : (s.n_clusters || 0); }   // 표본 수는 보수적으로 작은 쪽
+  }
+  const base = '과거 통계(' + SHK_STATS.coins + '개 코인 4시간봉, 이상 변동 봉 뒤, 충격 방향 기준)';
+  if (!parts.length) return '<div style="opacity:.8;margin-top:2px">' + base + ': 뒤 움직임의 방향이 통계적으로 확인되지 않아 반영하지 않음</div>';
+  const first = SHK_STATS.horizons['1'], mean = (SHK_STATS.verdicts['6'] && SHK_STATS.verdicts['6'].use ? SHK_STATS.horizons['6'] : first).mean;
+  return '<div style="opacity:.9;margin-top:2px">' + base + ': ' + parts.join(' · ') + ' — ' + (mean < 0 ? '충격 반대 방향으로 되돌리는 경향' : '충격 방향으로 이어지는 경향')
+    + ' (서로 다른 날 ' + sample + '개, 수수료 차감 전, 참고용 · 확정 아님)</div>';
+}
