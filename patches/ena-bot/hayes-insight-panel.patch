@@ -0,0 +1,80 @@
+"""대시보드에 '변화 모니터링' 패널을 연결한다(wire_hayes_lookup.py를 먼저 적용해야 함). 여러 번 실행해도 안전.
+사용: .venv/bin/python tools/wire_hayes_insight.py [프로젝트 폴더]
+"""
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+dash = root / "ena_bot/dashboard.py"
+page = root / "ena_bot/dashboard_static/index.html"
+
+IMP_A = "from . import hayes_lookup\n"
+IMP_B = IMP_A + "from . import hayes_insight\n"
+GET_A = '                elif url.path == "/api/hayes-lookup":\n'
+GET_B = '''                elif url.path == "/api/hayes-insight":
+                    self._json(hayes_insight.summary(cfg.data_path / "hayes_holdings.sqlite"))
+''' + GET_A
+UI_A = '  <details class="panel hayes-lookup" id="hayes-lookup">'
+UI_B = '''  <section class="panel hayes-ins" id="hayes-ins"><div class="hi-title">아서 헤이즈 ENA 변화 모니터링</div><div id="hi-body">불러오는 중…</div></section>
+  <style>.hayes-ins{margin-bottom:10px;padding:10px 12px;font-size:12px}.hi-title{font-weight:600;color:var(--mute);margin-bottom:6px}
+  .hi-big{font-size:22px;font-weight:700}.hi-sub{color:var(--mute);margin:2px 0 6px}.hi-chips{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
+  .hi-chip{border:1px solid var(--line,#8884);border-radius:6px;padding:3px 8px}.hi-up{color:#2e9e5b}.hi-down{color:#d6453d}.hi-flat{color:var(--mute)}
+  .hi-sec{font-weight:600;margin:10px 0 3px}.hi-tbl{display:grid;grid-template-columns:max-content 1fr max-content;gap:2px 12px}.hi-tbl .w{overflow-wrap:anywhere}
+  .hi-warn{color:#d6453d;font-weight:600;margin:4px 0}.hi-spark{width:100%;height:56px;display:block}</style>
+  <script>(function(){
+    const body=document.getElementById('hi-body');
+    const el=(t,c,x)=>{const e=document.createElement(t);if(c)e.className=c;if(x!=null)e.textContent=x;return e;};
+    const num=(s,d)=>{const n=Number(s);return isFinite(n)?n.toLocaleString('en-US',{maximumFractionDigits:d==null?2:d}):s;};
+    const sign=(s)=>{const n=Number(s);return n>0?['▲ +','hi-up']:n<0?['▼ ','hi-down']:['― ','hi-flat'];};
+    const kst=(s)=>{const d=new Date(s);return isNaN(d)?s:d.toLocaleString('ko-KR',{timeZone:'Asia/Seoul',hour12:false,month:'2-digit',day:'2-digit',hour:'2-digit',minute:'2-digit'});};
+    function spark(series){
+      const NS='http://www.w3.org/2000/svg',w=300,h=56,svg=document.createElementNS(NS,'svg');svg.setAttribute('viewBox','0 0 '+w+' '+h);svg.setAttribute('class','hi-spark');svg.setAttribute('preserveAspectRatio','none');
+      const v=series.map(p=>p[1]),mn=Math.min(...v),mx=Math.max(...v),rg=(mx-mn)||1;
+      const pts=series.map((p,i)=>(series.length<2?w/2:i*w/(series.length-1)).toFixed(1)+','+(h-4-(p[1]-mn)/rg*(h-8)).toFixed(1));
+      const pl=document.createElementNS(NS,'polyline');pl.setAttribute('points',pts.join(' '));pl.setAttribute('fill','none');pl.setAttribute('stroke','currentColor');pl.setAttribute('stroke-width','2');svg.appendChild(pl);return svg;}
+    function render(j){
+      body.textContent='';
+      if(j.status&&j.status.status!=='ok'){const m={empty_config:'등록된 지갑이 없음',missing_provider:'공급자 설정 없음',missing_key:'API 키 없음',invalid_config:'설정 오류',request_failed:'조회 실패',partial_failure:'일부 지갑 조회 실패'};
+        body.appendChild(el('div','hi-warn','최근 수집 상태: '+(m[j.status.status]||j.status.status)+' · '+kst(j.status.checked_at)+(j.status.detail?' · '+j.status.detail.slice(0,160):'')));}
+      if(j.state!=='ok'){body.appendChild(el('div','hi-sub','아직 정상 수집된 기록이 없습니다. 위 패널에서 지갑을 등록하세요.'));return;}
+      body.appendChild(el('div','hi-big',num(j.total,2)+' ENA'));
+      let sub='마지막 확인 '+kst(j.observed_at)+' · 기록 '+j.snapshots+'건 · '+kst(j.since)+'부터';
+      body.appendChild(el('div','hi-sub',sub));
+      if(j.stale)body.appendChild(el('div','hi-warn','⚠ '+Math.floor(j.age_hours)+'시간 전 데이터 — 수집이 멈췄을 수 있습니다'));
+      if(j.price){body.appendChild(el('div','hi-sub','ENA '+num(j.price.value,4)+' USD · 평가액 약 $'+num(j.price.usd_value,0)+(j.price.usd_change_first_window?' (최근 변동 약 $'+num(j.price.usd_change_first_window,0)+')':'')));}
+      const chips=el('div','hi-chips');
+      if(!j.windows.length)chips.appendChild(el('span','hi-chip hi-flat','변화 비교는 기록이 더 쌓이면 표시됩니다'));
+      j.windows.forEach(w=>{const[sg,cl]=sign(w.change);const c=el('span','hi-chip '+cl,w.label+' '+sg+num(w.change,2)+(w.pct==null?'':' ('+(w.pct>0?'+':'')+w.pct.toFixed(2)+'%)')+(w.partial?' *':''));
+        c.title='기준 '+kst(w.from)+(w.partial?' · 기록이 짧아 가장 오래된 값 기준':'');chips.appendChild(c);});
+      body.appendChild(chips);
+      if(j.series.length>1)body.appendChild(spark(j.series));
+      if(j.wallets.length){body.appendChild(el('div','hi-sec','지갑별'));const t=el('div','hi-tbl');
+        j.wallets.forEach(w=>{t.appendChild(el('span','w',w.wallet.slice(0,6)+'…'+w.wallet.slice(-4)));t.appendChild(el('span',null,num(w.balance,2)+' ENA'+(w.share_pct==null?'':' ('+w.share_pct.toFixed(0)+'%)')));
+          const[sg,cl]=sign(w.change_24h);t.appendChild(el('span',cl,'24h '+(Number(w.change_24h)===0?'변화 없음':sg+num(w.change_24h,2))));});body.appendChild(t);}
+      body.appendChild(el('div','hi-sec','최근 변동'));
+      if(!j.events.length)body.appendChild(el('div','hi-sub','아직 보유량이 바뀐 기록이 없습니다'));
+      j.events.forEach(e=>{const[sg,cl]=sign(e.delta);const r=el('div',cl,kst(e.at)+'  '+sg+num(e.delta,2)+' ENA → 합계 '+num(e.total,2));body.appendChild(r);});
+    }
+    async function load(){try{const r=await fetch('/api/hayes-insight');if(r.ok)render(await r.json());}catch(e){}}
+    load();setInterval(load,60000);
+  })();</script>
+''' + UI_A
+
+
+def edit(path, a, b, done):
+    s = path.read_text(encoding="utf-8")
+    if done in s:
+        print("이미 적용됨:", path.name, done)
+        return
+    path.write_text(s.replace(a, b, 1), encoding="utf-8")
+    print("수정:", path.name)
+
+
+ds, ps = dash.read_text(encoding="utf-8"), page.read_text(encoding="utf-8")
+checks = [(ds, IMP_A, "from . import hayes_insight"), (ds, GET_A, "/api/hayes-insight"), (ps, UI_A, 'id="hayes-ins"')]
+for s, a, done in checks:
+    if done not in s and s.count(a) != 1:
+        raise SystemExit(f"연결할 위치를 찾지 못했습니다(조회·등록 패치를 먼저 적용했는지 확인): {a.strip()[:50]} — 수정하지 않았습니다.")
+edit(dash, IMP_A, IMP_B, "from . import hayes_insight")
+edit(dash, GET_A, GET_B, "/api/hayes-insight")
+edit(page, UI_A, UI_B, 'id="hayes-ins"')
