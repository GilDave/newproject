+"""ENA 봇 대시보드 차트에 추세선·엘리엇 자동 작도를 연결한다(index.html 두 곳). 여러 번 실행해도 안전하고, 위치를 못 찾으면 아무것도 바꾸지 않는다.
+사용: .venv/bin/python tools/wire_structure_chart.py [프로젝트 폴더]
+"""
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+page = root / "ena_bot/dashboard_static/index.html"
+js = Path(__file__).with_name("structure_chart.js").read_text(encoding="utf-8")
+
+A = "  if (TRNC) ms.push(...TRNC.markers());\n"
+A2 = A + "  structDraw();\n"
+C = "let TRNC = null;   // makeTrnChart 인스턴스(스크립트 끝에서 생성)\n"
+C2 = js.rstrip("\n") + "\n" + C
+
+text = page.read_text(encoding="utf-8")
+if "function stAnalyze" in text:
+    print("이미 적용됨")
+    raise SystemExit(0)
+for name, old in (("마커 위치", A), ("선언 위치", C)):
+    if text.count(old) != 1:
+        raise SystemExit(f"{name}를 찾지 못했습니다({text.count(old)}곳). index.html 을 수정하지 않았습니다.")
+page.write_text(text.replace(A, A2, 1).replace(C, C2, 1), encoding="utf-8")
+print("수정: index.html")
