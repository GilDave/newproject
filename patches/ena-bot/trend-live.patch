new file mode 100644
index 0000000..669e857
--- /dev/null
+++ b/ena_bot/live_venues.py
@@ -0,0 +1,252 @@
+"""실거래 브로커(trend_live)가 쓰는 거래소 어댑터. 거래소마다 다른 점(주문 방식, 손절 방식, 계정·포지션 조회)을 여기에 가둔다.
+
+공통 약속(어댑터가 지켜야 하는 것):
+- position(symbol) -> (부호 있는 수량, 평균 진입가, 거래소 손절가 또는 0). 단방향 모드가 아니면 VenueRefused.
+- market(...)은 시장가 주문 하나를 보낸다. 같은 주문 ID가 이미 쓰였음을 거래소가 알려 주면 DuplicateOrder.
+- order_exists(symbol, link_id)는 같은 ID의 주문이 이미 있는지 거래소에 묻는다(응답 유실 뒤 재전송 방지).
+- set_stop / clear_stops는 포지션 전체를 닫는 거래소 측 손절을 건다/모두 지운다.
+
+Binance USDⓈ-M 선물의 규칙은 공식 파이썬 SDK(binance-sdk-derivatives-trading-usds-futures 18.4.0)의 엔드포인트·파라미터 정의로 확인했다.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import math
+import time
+from dataclasses import dataclass
+from decimal import Decimal
+from urllib.parse import urlencode
+
+BINANCE_MAINNET = "https://fapi.binance.com"
+BINANCE_TESTNET = "https://testnet.binancefuture.com"
+BINANCE_NO_SUCH_ORDER = -2013
+BYBIT_DUP_LINK_CODE = 110072
+
+
+class VenueError(Exception):
+    """거래소가 요청을 거절했거나 응답이 올바르지 않다."""
+
+    def __init__(self, msg: str, code: int = 0, path: str = ""):
+        super().__init__(f"{msg} (코드 {code}, {path})" if code or path else msg)
+        self.msg, self.code, self.path = msg, code, path
+
+
+class VenueRefused(RuntimeError):
+    """이 계정 설정으로는 안전하게 거래할 수 없다(예: 헤지 모드)."""
+
+
+class DuplicateOrder(Exception):
+    """같은 주문 ID가 이미 쓰였다."""
+
+
+@dataclass
+class VenueInstrument:
+    symbol: str
+    qty_step: float
+    min_qty: float
+    tick_size: float
+    min_notional: float = 5.0
+
+
+# ---------------------------------------------------------------------------------------------- Bybit
+class BybitVenue:
+    """기존 ena_bot.exchange.BybitClient를 어댑터 약속에 맞춘다."""
+
+    name = "bybit"
+
+    def __init__(self, client):
+        self.client = client
+
+    def _call(self, fn, *a, **kw):
+        from .exchange import BybitError
+        try:
+            return fn(*a, **kw)
+        except BybitError as exc:
+            if exc.code == BYBIT_DUP_LINK_CODE:
+                raise DuplicateOrder(str(exc)) from exc
+            raise VenueError(exc.msg, exc.code) from exc
+
+    def instrument(self, symbol: str):
+        i = self._call(self.client.get_instrument, symbol)
+        return VenueInstrument(symbol, i.qty_step, i.min_qty, i.tick_size, 5.0)
+
+    def equity(self) -> float:
+        return float(self._call(self.client.get_equity))
+
+    def position(self, symbol: str) -> tuple[float, float, float]:
+        res = self._call(self.client._request, "GET", "/v5/position/list", {"category": "linear", "symbol": symbol}, signed=True)
+        rows = res.get("list", []) or []
+        if any(int(p.get("positionIdx") or 0) != 0 for p in rows):
+            raise VenueRefused("이 계정은 헤지 모드로 보입니다. 단방향(one-way) 포지션 모드로 바꾼 뒤 사용하세요.")
+        for p in rows:
+            size = float(p.get("size") or 0)
+            if size > 0:
+                return (size if p.get("side") == "Buy" else -size), float(p.get("avgPrice") or 0), float(p.get("stopLoss") or 0)
+        return 0.0, 0.0, 0.0
+
+    def set_leverage(self, symbol: str, leverage: float) -> None:
+        self._call(self.client.set_leverage, symbol, leverage)
+
+    def market(self, symbol: str, side: str, qty_str: str, link_id: str, reduce_only: bool, stop_price: str | None) -> None:
+        self._call(self.client.create_market_order, symbol, side, qty_str, link_id, stop_loss=stop_price, reduce_only=reduce_only)
+
+    def order_exists(self, symbol: str, link_id: str) -> bool:
+        return False  # Bybit는 같은 orderLinkId를 거부해 준다(DuplicateOrder)
+
+    def set_stop(self, symbol: str, signed_qty: float, stop_price: str) -> None:
+        params = {"category": "linear", "symbol": symbol, "stopLoss": stop_price, "slTriggerBy": "MarkPrice", "tpslMode": "Full", "positionIdx": 0}
+        self._call(self.client._request, "POST", "/v5/position/trading-stop", params, signed=True)
+
+    def clear_stops(self, symbol: str) -> None:
+        return None  # Bybit의 포지션 손절은 포지션이 닫히면 함께 사라진다
+
+    def last_price(self, symbol: str) -> float:
+        return float(self._call(self.client.get_klines, symbol, 1, 2).close[-1])
+
+
+# -------------------------------------------------------------------------------------------- Binance
+class BinanceFutures:
+    """Binance USDⓈ-M 선물 REST. 서명: 쿼리 문자열(timestamp·recvWindow 포함)의 HMAC-SHA256 → signature를 끝에 붙인다. 키는 X-MBX-APIKEY 헤더."""
+
+    name = "binance"
+
+    def __init__(self, base_url: str, api_key: str, api_secret: str, *, session=None, clock=time.time, recv_window: int = 5000, timeout: float = 15.0):
+        self.base_url = base_url.rstrip("/")
+        self.api_key, self.api_secret = api_key, api_secret
+        self.clock, self.recv_window, self.timeout = clock, recv_window, timeout
+        if session is None:
+            import requests
+            session = requests.Session()
+        self.session = session
+        self._dual_checked = False
+        self._inst: dict[str, VenueInstrument] = {}
+
+    # -- 요청
+    def _request(self, method: str, path: str, params: dict | None = None, signed: bool = True):
+        p = {k: v for k, v in (params or {}).items() if v is not None}
+        if signed:
+            p["timestamp"] = int(self.clock() * 1000)
+            p["recvWindow"] = self.recv_window
+        query = urlencode(p)
+        if signed:
+            query += "&signature=" + hmac.new(self.api_secret.encode(), query.encode(), hashlib.sha256).hexdigest()
+        url = f"{self.base_url}{path}" + (f"?{query}" if query else "")
+        try:
+            r = self.session.request(method, url, headers={"X-MBX-APIKEY": self.api_key}, timeout=self.timeout)
+        except Exception as exc:  # 네트워크 오류
+            raise VenueError(f"요청 실패: {type(exc).__name__}: {exc}", 0, path) from exc
+        try:
+            data = r.json()
+        except ValueError as exc:
+            raise VenueError(f"응답을 해석하지 못했습니다(HTTP {r.status_code})", r.status_code, path) from exc
+        if r.status_code >= 400 or (isinstance(data, dict) and isinstance(data.get("code"), int) and data["code"] < 0):
+            code = data.get("code", r.status_code) if isinstance(data, dict) else r.status_code
+            raise VenueError(str(data.get("msg", data)) if isinstance(data, dict) else str(data), int(code), path)
+        return data
+
+    # -- 상품
+    def instrument(self, symbol: str) -> VenueInstrument:
+        if symbol in self._inst:
+            return self._inst[symbol]
+        info = self._request("GET", "/fapi/v1/exchangeInfo", None, signed=False)
+        sym = next((s for s in info.get("symbols", []) if s.get("symbol") == symbol), None)
+        if sym is None:
+            raise VenueError(f"{symbol} 상품 정보를 찾지 못했습니다", 0, "/fapi/v1/exchangeInfo")
+        f = {x.get("filterType"): x for x in sym.get("filters", [])}
+        lot = f.get("MARKET_LOT_SIZE") or f.get("LOT_SIZE") or {}
+        price = f.get("PRICE_FILTER") or {}
+        notional = f.get("MIN_NOTIONAL") or {}
+        try:
+            inst = VenueInstrument(symbol, float(lot["stepSize"]), float(lot["minQty"]), float(price["tickSize"]), float(notional.get("notional") or 5.0))
+        except (KeyError, ValueError) as exc:
+            raise VenueError("상품 필터(수량·호가 단위)를 읽지 못했습니다", 0, "/fapi/v1/exchangeInfo") from exc
+        self._inst[symbol] = inst
+        return inst
+
+    def last_price(self, symbol: str) -> float:
+        return float(self._request("GET", "/fapi/v1/ticker/price", {"symbol": symbol}, signed=False)["price"])
+
+    # -- 계정·포지션
+    def equity(self) -> float:
+        acct = self._request("GET", "/fapi/v3/account")
+        try:
+            return float(acct["totalMarginBalance"])  # 지갑 잔고 + 미실현 손익
+        except (KeyError, ValueError) as exc:
+            raise VenueError("계정 응답에 totalMarginBalance가 없습니다", 0, "/fapi/v3/account") from exc
+
+    def _check_one_way(self) -> None:
+        if self._dual_checked:
+            return
+        mode = self._request("GET", "/fapi/v1/positionSide/dual")
+        if bool(mode.get("dualSidePosition")) is True:
+            raise VenueRefused("이 계정은 헤지 모드(Hedge Mode)입니다. 단방향(One-way) 포지션 모드로 바꾼 뒤 사용하세요.")
+        self._dual_checked = True
+
+    def _open_stops(self, symbol: str) -> list[dict]:
+        rows = self._request("GET", "/fapi/v1/openAlgoOrders", {"symbol": symbol})
+        rows = rows if isinstance(rows, list) else rows.get("orders", []) if isinstance(rows, dict) else []
+        return [r for r in rows if str(r.get("closePosition")).lower() == "true" and r.get("orderType", r.get("type")) == "STOP_MARKET"]
+
+    def position(self, symbol: str) -> tuple[float, float, float]:
+        self._check_one_way()
+        rows = self._request("GET", "/fapi/v3/positionRisk", {"symbol": symbol})
+        rows = rows if isinstance(rows, list) else [rows]
+        for p in rows:
+            if p.get("symbol", symbol) != symbol or p.get("positionSide", "BOTH") != "BOTH":
+                continue
+            qty = float(p.get("positionAmt") or 0)
+            if qty == 0:
+                return 0.0, 0.0, 0.0
+            want_side = "SELL" if qty > 0 else "BUY"
+            stops = [float(s.get("triggerPrice") or s.get("stopPrice") or 0) for s in self._open_stops(symbol) if str(s.get("side", want_side)).upper() == want_side]
+            live = [x for x in stops if x > 0]
+            stop = (max(live) if qty > 0 else min(live)) if live else 0.0  # 가격에 가장 가까운(보수적인) 손절가
+            return qty, float(p.get("entryPrice") or 0), stop
+        return 0.0, 0.0, 0.0
+
+    def set_leverage(self, symbol: str, leverage: float) -> None:
+        self._request("POST", "/fapi/v1/leverage", {"symbol": symbol, "leverage": max(1, int(math.floor(leverage)))})
+
+    # -- 주문
+    def market(self, symbol: str, side: str, qty_str: str, link_id: str, reduce_only: bool, stop_price: str | None) -> None:
+        # Binance의 일반 주문에는 손절을 붙일 수 없다: 체결 뒤 set_stop 으로 따로 건다(stop_price는 쓰지 않는다)
+        params = {"symbol": symbol, "side": side.upper(), "type": "MARKET", "quantity": qty_str, "newClientOrderId": link_id,
+                  "newOrderRespType": "RESULT", "reduceOnly": "true" if reduce_only else None}
+        self._request("POST", "/fapi/v1/order", params)
+
+    def order_exists(self, symbol: str, link_id: str) -> bool:
+        """응답 유실 뒤 재전송을 막으려고, 보내기 전에 같은 ID의 주문이 있는지 거래소에 묻는다(시장가는 즉시 체결돼 닫히므로 거래소의 중복 거부에 기대지 않는다)."""
+        try:
+            self._request("GET", "/fapi/v1/order", {"symbol": symbol, "origClientOrderId": link_id})
+            return True
+        except VenueError as exc:
+            if exc.code == BINANCE_NO_SUCH_ORDER:
+                return False
+            raise
+
+    def set_stop(self, symbol: str, signed_qty: float, stop_price: str) -> None:
+        """포지션 전체를 닫는 STOP_MARKET(알고 주문)을 새로 걸고, 성공한 뒤에 이전 손절을 지운다(걸기에 실패해도 이전 손절은 남는다)."""
+        old = [s.get("algoId") for s in self._open_stops(symbol)]
+        params = {"algoType": "CONDITIONAL", "symbol": symbol, "side": "SELL" if signed_qty > 0 else "BUY", "type": "STOP_MARKET",
+                  "triggerPrice": stop_price, "closePosition": "true", "workingType": "MARK_PRICE",
+                  "clientAlgoId": f"enastop{int(self.clock() * 1000)}"}
+        new = self._request("POST", "/fapi/v1/algoOrder", params)
+        for algo_id in old:
+            if algo_id is not None and algo_id != new.get("algoId"):
+                self._request("DELETE", "/fapi/v1/algoOrder", {"algoId": algo_id})
+
+    def clear_stops(self, symbol: str) -> None:
+        for s in self._open_stops(symbol):
+            if s.get("algoId") is not None:
+                self._request("DELETE", "/fapi/v1/algoOrder", {"algoId": s["algoId"]})
+
+
+def build_venue(exchange: str, mode: str, key: str, secret: str):
+    """실제 거래소 어댑터. mode: testnet | live."""
+    if exchange == "binance":
+        return BinanceFutures(BINANCE_TESTNET if mode == "testnet" else BINANCE_MAINNET, key, secret)
+    from .exchange import MAINNET, TESTNET, BybitClient
+    return BybitVenue(BybitClient(TESTNET if mode == "testnet" else MAINNET, key, secret))
diff --git a/ena_bot/trend_live.py b/ena_bot/trend_live.py
new file mode 100644
index 0000000..c2e056c
--- /dev/null
+++ b/ena_bot/trend_live.py
@@ -0,0 +1,503 @@
+"""4시간봉 추세 엔진용 거래소 브로커(테스트넷 우선, 메인넷은 여러 겹의 안전장치 뒤에서만). 거래소: Bybit 또는 Binance(USDⓈ-M 선물).
+
+엔진(TrendEngine)은 브로커에 목표 수량만 알려 주고(`rebalance(목표수량, 가격)`), 이 브로커가 거래소의 '실제' 포지션을 읽어
+차이만큼 주문한다. 거래소별 차이는 live_venues 의 어댑터가 맡는다. 원칙:
+- 거래소가 기준이다: 매 사이클 포지션·잔고를 다시 읽고, 주문 뒤에는 반영될 때까지 확인한다. 반영이 확인되지 않으면 재주문하지 않고 멈춘다.
+- 상한은 코드에 박혀 있다(1회 주문, 총 명목가, 레버리지). 환경 변수로는 낮추기만 할 수 있다.
+- 포지션에는 항상 거래소 측 손절이 붙는다. 손절을 걸지 못하면 포지션을 닫고 멈춘다. 포지션이 없으면 남은 손절도 지운다.
+- 킬 스위치(STOP 파일)가 있으면 늘리는 주문은 하지 않고 정리만 한다.
+- 메인넷은 live_enabled + 확인 플래그 + 왕복 시험 통과 기록 + 직접 입력한 확인 문구가 모두 있어야 한다.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import sys
+import time
+from dataclasses import dataclass
+from decimal import ROUND_DOWN, ROUND_HALF_UP, Decimal
+from pathlib import Path
+
+from .live_venues import DuplicateOrder, VenueError, VenueRefused, build_venue
+
+# 메인넷 상한은 일부러 아주 작다. 올리려면 이 파일을 고쳐야 한다(환경 변수로는 낮추기만 가능).
+HARD_LIMITS = {
+    "testnet": {"max_notional_usd": 20000.0, "max_order_usd": 5000.0, "max_leverage": 2.0},
+    "live": {"max_notional_usd": 150.0, "max_order_usd": 100.0, "max_leverage": 1.5},
+}
+DEFAULT_STOP_PCT = 0.10
+STOP_PCT_RANGE = (0.02, 0.30)
+PASS_FILE = Path("data") / "trend_testnet_pass.json"  # 왕복 시험(테스트넷 또는 메인넷 극소액) 통과 기록
+PASS_MAX_AGE_DAYS = 30
+MAINNET_TEST_USD = 12.0        # 메인넷 왕복 시험의 주문 크기(명목가). 수수료는 몇 센트 수준
+MAINNET_TEST_CAP_USD = 25.0    # 시험 중에는 상한도 이 값으로 낮춘다
+EXCHANGES = ("bybit", "binance")
+
+
+class LiveRefused(RuntimeError):
+    """시작 조건을 채우지 못해 실거래 브로커를 만들지 않았다."""
+
+
+class LiveSafetyError(RuntimeError):
+    """주문 중 안전 조건이 깨졌다(반영 미확인, 손절 실패 등). 엔진은 이 사이클을 처리하지 않은 채 멈춘다."""
+
+
+@dataclass
+class LiveLimits:
+    max_notional_usd: float
+    max_order_usd: float
+    max_leverage: float
+    stop_pct: float
+
+
+def _env_float(env, name: str, hard: float, lo: float = 0.0) -> float:
+    raw = (env.get(name) or "").strip()
+    if not raw:
+        return hard
+    try:
+        v = float(raw)
+    except ValueError as exc:
+        raise LiveRefused(f"{name} 값이 숫자가 아닙니다: {raw!r}") from exc
+    if not (v > lo) or math.isnan(v):
+        raise LiveRefused(f"{name}은 {lo}보다 커야 합니다: {raw!r}")
+    return min(v, hard)  # 낮추기만 한다
+
+
+def resolve_limits(mode: str, env, risk_max_leverage: float) -> LiveLimits:
+    hard = HARD_LIMITS["live" if mode == "live" else "testnet"]
+    raw = (env.get("ENA_LIVE_HARD_STOP_PCT") or "").strip()
+    pct = DEFAULT_STOP_PCT
+    if raw:
+        try:
+            pct = float(raw)
+        except ValueError as exc:
+            raise LiveRefused(f"ENA_LIVE_HARD_STOP_PCT 값이 숫자가 아닙니다: {raw!r}") from exc
+    if not (STOP_PCT_RANGE[0] <= pct <= STOP_PCT_RANGE[1]):
+        raise LiveRefused(f"거래소 손절 거리(ENA_LIVE_HARD_STOP_PCT)는 {STOP_PCT_RANGE[0]:.0%}~{STOP_PCT_RANGE[1]:.0%} 사이여야 합니다: {pct}")
+    return LiveLimits(
+        max_notional_usd=_env_float(env, "ENA_LIVE_MAX_NOTIONAL_USD", hard["max_notional_usd"]),
+        max_order_usd=_env_float(env, "ENA_LIVE_MAX_ORDER_USD", hard["max_order_usd"]),
+        max_leverage=min(_env_float(env, "ENA_LIVE_MAX_LEVERAGE", hard["max_leverage"]), float(risk_max_leverage)),
+        stop_pct=pct,
+    )
+
+
+def resolve_exchange(env) -> str:
+    name = (env.get("ENA_EXCHANGE") or "bybit").strip().lower()
+    if name not in EXCHANGES:
+        raise LiveRefused(f"ENA_EXCHANGE는 {' 또는 '.join(EXCHANGES)} 이어야 합니다: {name!r}")
+    return name
+
+
+def _dec(x) -> Decimal:
+    return Decimal(str(x))
+
+
+def _floor(x: float, step: float) -> float:
+    if step <= 0:
+        return float(x)
+    return float((_dec(x) / _dec(step)).to_integral_value(rounding=ROUND_DOWN) * _dec(step))
+
+
+def _fmt(x: float, step: float, rounding=ROUND_DOWN) -> str:
+    d = (_dec(x) / _dec(step)).to_integral_value(rounding=rounding) * _dec(step)
+    return format(d.normalize(), "f")
+
+
+class TrendLiveBroker:
+    """TrendEngine이 쓰는 브로커 인터페이스(qty, balance, equity, rebalance, state_dict …)를 거래소 주문으로 구현한다."""
+
+    live = True
+
+    def __init__(self, cfg, venue, mode: str, limits: LiveLimits, notifier=None, *, clock=time.time, sleep=time.sleep,
+                 stop_files=None, confirm_polls: int = 15):
+        self.cfg, self.venue, self.mode, self.limits, self.notifier = cfg, venue, mode, limits, notifier
+        self.symbol = cfg.symbol
+        self.clock, self.sleep, self.confirm_polls = clock, sleep, confirm_polls
+        self.total_fees = 0.0  # 거래소 정산값을 쓰므로 가상 수수료 누적은 없다
+        self._equity = 0.0
+        self._inst = None
+        self._snap = (0.0, 0.0, 0.0, 0.0)  # (조회 시각, 부호 있는 수량, 평균 진입가, 거래소 손절가)
+        self._orders = 0
+        self._stop_files = stop_files if stop_files is not None else [Path(cfg.data_path) / "STOP", Path("data") / "STOP"]
+
+    # ------------------------------------------------------------------ 거래소 상태
+    def _say(self, text: str) -> None:
+        tag = ("테스트넷" if self.mode != "live" else "⚠ 메인넷") + f" {self.venue.name}"
+        if self.notifier is not None:
+            try:
+                self.notifier.send(f"[{tag} 실주문] {text}")
+            except Exception:  # noqa: BLE001 - 알림 실패가 주문 안전 흐름을 깨면 안 된다
+                pass
+
+    def instrument(self):
+        if self._inst is None:
+            self._inst = self.venue.instrument(self.symbol)
+        return self._inst
+
+    def _killed(self) -> bool:
+        return any(Path(p).exists() for p in self._stop_files)
+
+    def refresh(self, force: bool = False) -> tuple[float, float, float]:
+        """거래소의 실제 포지션을 읽는다(2초 캐시). (부호 있는 수량, 평균 진입가, 손절가). 단방향 모드가 아니면 거부한다."""
+        now = self.clock()
+        if not force and now - self._snap[0] < 2.0 and self._snap[0] > 0:
+            return self._snap[1:]
+        try:
+            qty, entry, stop = self.venue.position(self.symbol)
+        except VenueRefused as exc:
+            raise LiveRefused(str(exc)) from exc
+        self._snap = (now, qty, entry, stop)
+        return qty, entry, stop
+
+    @property
+    def qty(self) -> float:
+        return self.refresh()[0]
+
+    @property
+    def entry(self) -> float:
+        return self.refresh()[1]
+
+    @property
+    def balance(self) -> float:
+        if self._equity <= 0:
+            self._equity = float(self.venue.equity())
+        return self._equity
+
+    def equity(self, price: float) -> float:
+        self._equity = float(self.venue.equity())
+        qty, entry, stop = self.refresh()
+        if qty != 0 and stop <= 0:  # 거래소 손절이 없는 포지션은 허용하지 않는다(수동 변경·취소 대비)
+            self._set_stop(qty, entry or price)
+        elif qty == 0:  # 포지션이 없는데 손절이 남아 있으면 다음 포지션을 엉뚱한 가격에서 닫을 수 있다
+            self._clear_stops()
+        return self._equity
+
+    # 펀딩비는 거래소가 잔고에서 직접 정산한다
+    def accrue_funding(self, price: float, hours: float) -> None:
+        return None
+
+    def accrue_funding_actual(self, price: float, rates: list) -> float:
+        return 0.0
+
+    # ------------------------------------------------------------------ 손절
+    def _stop_price(self, signed_qty: float, ref: float) -> str:
+        inst = self.instrument()
+        raw = ref * (1 - self.limits.stop_pct) if signed_qty > 0 else ref * (1 + self.limits.stop_pct)
+        return _fmt(raw, inst.tick_size, ROUND_HALF_UP)
+
+    def _set_stop(self, signed_qty: float, ref: float) -> None:
+        self.venue.set_stop(self.symbol, signed_qty, self._stop_price(signed_qty, ref))
+        self._snap = (0.0, *self._snap[1:])  # 다음 조회는 거래소에서 다시 읽는다
+
+    def _clear_stops(self) -> None:
+        try:
+            self.venue.clear_stops(self.symbol)
+        except VenueError as exc:
+            self._say(f"포지션이 없는데 남은 손절 주문을 지우지 못했습니다. 거래소 앱에서 확인하세요: {exc}")
+
+    # ------------------------------------------------------------------ 주문
+    def _link_id(self, leg: str, side: str, qty_str: str) -> str:
+        bucket = int(self.clock() // (4 * 3600))  # 같은 4시간 봉에서 같은 주문을 다시 보내면 중복으로 본다
+        h = hashlib.sha1(f"{self.symbol}|{bucket}|{leg}|{side}|{qty_str}".encode()).hexdigest()[:20]
+        return f"ena{self.mode[0]}{h}"  # 24자: 거래소 주문 ID 길이 제한(36자) 안
+
+    def _wait_for(self, expected: float) -> float:
+        step = self.instrument().qty_step
+        got = 0.0
+        for _ in range(self.confirm_polls):
+            got = self.refresh(force=True)[0]
+            if abs(got - expected) <= step / 2:
+                return got
+            self.sleep(1.0)
+        raise LiveSafetyError(f"주문 반영을 확인하지 못했습니다(기대 {expected:+g}, 실제 {got:+g}). 재주문하지 않고 멈춥니다. 거래소 앱에서 포지션을 확인하세요.")
+
+    def _send(self, leg: str, side: str, qty: float, *, reduce_only: bool, stop_ref: float | None, expected_after: float) -> None:
+        inst = self.instrument()
+        qty_str = _fmt(qty, inst.qty_step)
+        link = self._link_id(leg, side, qty_str)
+        stop = self._stop_price(1.0 if side == "Buy" else -1.0, stop_ref) if stop_ref is not None else None
+        if self.venue.order_exists(self.symbol, link):
+            self._say(f"같은 주문 ID가 이미 있어 재전송하지 않고 반영만 확인합니다({leg})")
+        else:
+            try:
+                self.venue.market(self.symbol, side, qty_str, link, reduce_only, stop)
+            except DuplicateOrder:
+                self._say(f"같은 주문 ID가 이미 있어 재전송하지 않고 반영만 확인합니다({leg})")  # 응답 유실 뒤 재시도: 이미 나간 주문
+        self._orders += 1
+        self._wait_for(expected_after)
+
+    def _flatten(self, reason: str) -> None:
+        qty = self.refresh(force=True)[0]
+        if qty != 0:
+            self._send("flat", "Sell" if qty > 0 else "Buy", abs(qty), reduce_only=True, stop_ref=None, expected_after=0.0)
+        self._clear_stops()
+        self._say(f"포지션을 정리했습니다: {reason}")
+
+    def _cap_qty(self, price: float, equity: float) -> float:
+        lim = self.limits
+        by_notional = lim.max_notional_usd / price
+        by_leverage = lim.max_leverage * equity / price
+        return _floor(max(0.0, min(by_notional, by_leverage)), self.instrument().qty_step)
+
+    def rebalance(self, target_qty: float, price: float) -> float:
+        """목표 수량(부호 있음)으로 맞춘다. 거래소에서 실제로 바뀐 수량(부호 있음)을 돌려준다."""
+        if not price > 0:
+            raise LiveSafetyError(f"가격이 올바르지 않습니다: {price}")
+        inst = self.instrument()
+        step, min_qty = inst.qty_step, inst.min_qty
+        min_notional = float(getattr(inst, "min_notional", 0.0) or 0.0)
+        cur, entry, _ = self.refresh(force=True)
+        start_qty = cur
+        eq = self.equity(price)
+        sign = 1.0 if target_qty >= 0 else -1.0
+        if self._killed():
+            tgt = 0.0  # 킬 스위치: 정리만 한다
+        else:
+            tgt = sign * min(_floor(abs(target_qty), step), self._cap_qty(price, eq))
+            if abs(tgt) < min_qty or abs(tgt) * price < min_notional:
+                tgt = 0.0
+        if abs(tgt - cur) < max(min_qty, step) - 1e-12:
+            return 0.0
+
+        max_order_qty = _floor(self.limits.max_order_usd / price, step)
+        flip = cur != 0 and (tgt == 0 or (tgt > 0) != (cur > 0))
+        if flip:  # 반대 방향이면 먼저 줄이기 전용으로 모두 닫고, 그다음 새로 연다
+            self._send("close", "Sell" if cur > 0 else "Buy", abs(cur), reduce_only=True, stop_ref=None, expected_after=0.0)
+            self._clear_stops()
+            cur = 0.0
+        if tgt != 0 and abs(tgt) > abs(cur):  # 늘리기(신규 포함): 1회 주문 상한을 넘지 않는다
+            add = min(abs(tgt) - abs(cur), max_order_qty)
+            if add >= min_qty and add * price >= min_notional:
+                side = "Buy" if tgt > 0 else "Sell"
+                after = cur + (add if tgt > 0 else -add)
+                self._send("open" if cur == 0 else "add", side, add, reduce_only=False, stop_ref=price, expected_after=after)
+                cur = after
+        elif tgt != 0 and abs(tgt) < abs(cur):  # 줄이기: 상한 없이 전량 허용
+            cut = abs(cur) - abs(tgt)
+            self._send("cut", "Sell" if cur > 0 else "Buy", cut, reduce_only=True, stop_ref=None, expected_after=tgt)
+            cur = tgt
+        final, avg, stop = self.refresh(force=True)
+        if final != 0:  # 평균 진입가가 바뀌었으니 손절을 다시 맞춘다. 실패하면 포지션을 닫고 멈춘다
+            try:
+                self._set_stop(final, avg or price)
+                if self.refresh(force=True)[2] <= 0:
+                    raise LiveSafetyError("거래소에 손절이 등록되지 않았습니다")
+            except (VenueError, LiveSafetyError) as exc:
+                self._flatten(f"거래소 손절을 걸지 못함 ({exc})")
+                raise LiveSafetyError(f"거래소 손절을 걸지 못해 포지션을 정리했습니다: {exc}") from exc
+        else:
+            self._clear_stops()
+        return final - start_qty
+
+    # ------------------------------------------------------------------ 엔진 상태 저장
+    def state_dict(self) -> dict:
+        qty, entry, _ = self.refresh()
+        return {"balance": self._equity, "qty": qty, "entry": entry, "total_fees": 0.0, "live": self.mode, "exchange": self.venue.name, "orders": self._orders}
+
+    def load_state(self, d: dict) -> None:
+        self._orders = int(d.get("orders", 0)) if isinstance(d, dict) else 0
+
+    @property
+    def startup_text(self) -> str:
+        lim = self.limits
+        label = "테스트넷 실주문" if self.mode != "live" else "⚠ 메인넷 실거래"
+        return (f"추세추종 {label}({self.venue.name}) 시작 {self.symbol} equity={self.balance:.2f} · 상한 명목가 ${lim.max_notional_usd:g} · "
+                f"1회 ${lim.max_order_usd:g} · 레버리지 {lim.max_leverage:g}x · 거래소 손절 {lim.stop_pct:.0%}")
+
+    def preflight(self) -> dict:
+        """주문 없이 계정·상품·포지션 모드를 점검한다. 문제가 있으면 LiveRefused."""
+        try:
+            inst = self.instrument()
+            qty, entry, stop = self.refresh(force=True)
+            eq = float(self.venue.equity())
+            if not eq > 0:
+                raise LiveRefused(f"계정 자본이 0 이하입니다({eq}). 입금 또는 테스트넷 자금을 확인하세요.")
+            self.venue.set_leverage(self.symbol, self.limits.max_leverage)
+        except VenueError as exc:
+            raise LiveRefused(f"거래소 점검 실패: {exc}") from exc
+        self._equity = eq
+        return {"equity": eq, "qty": qty, "entry": entry, "stop": stop, "min_qty": inst.min_qty, "qty_step": inst.qty_step, "tick": inst.tick_size,
+                "min_notional": float(getattr(inst, "min_notional", 0.0) or 0.0)}
+
+
+# ---------------------------------------------------------------------- 만들기(시작 조건)
+def _keys(exchange: str, mode: str, env) -> tuple[str, str, str]:
+    """(키, 시크릿, 안내용 변수 이름). 테스트넷 키와 메인넷 키는 이름이 다르다."""
+    pre = "BINANCE" if exchange == "binance" else "BYBIT"
+    if mode == "live":
+        return (env.get(f"{pre}_API_KEY") or "").strip(), (env.get(f"{pre}_API_SECRET") or "").strip(), f"{pre}_API_KEY / {pre}_API_SECRET"
+    return ((env.get(f"{pre}_TESTNET_API_KEY") or env.get(f"{pre}_API_KEY") or "").strip(),
+            (env.get(f"{pre}_TESTNET_API_SECRET") or env.get(f"{pre}_API_SECRET") or "").strip(), f"{pre}_TESTNET_API_KEY / {pre}_TESTNET_API_SECRET")
+
+
+def testnet_pass_ok(now: float | None = None, path: Path = PASS_FILE, exchange: str | None = None) -> tuple[bool, str]:
+    try:
+        d = json.loads(Path(path).read_text(encoding="utf-8"))
+        age = ((now if now is not None else time.time()) - float(d["ts"])) / 86400
+    except (OSError, ValueError, KeyError, TypeError):
+        return False, "왕복 시험 통과 기록이 없습니다"
+    if exchange is not None and d.get("exchange", "bybit") != exchange:
+        return False, f"왕복 시험 통과 기록이 다른 거래소({d.get('exchange', 'bybit')})의 것입니다"
+    if age > PASS_MAX_AGE_DAYS:
+        return False, f"왕복 시험 통과 기록이 {age:.0f}일 지났습니다(최대 {PASS_MAX_AGE_DAYS}일)"
+    return True, ""
+
+
+def make_trend_broker(cfg, args, env, paper_cls, notifier=None, *, venue_factory=build_venue, input_fn=input, isatty=None, pass_path: Path = PASS_FILE,
+                      clock=time.time, sleep=time.sleep):
+    """config의 mode에 맞는 브로커. paper면 기존 페이퍼 브로커. 조건이 모자라면 LiveRefused."""
+    if cfg.mode == "paper":
+        return paper_cls(cfg)
+    if cfg.mode not in ("testnet", "live"):
+        raise LiveRefused(f"알 수 없는 mode: {cfg.mode}")
+    exchange = resolve_exchange(env)
+    limits = resolve_limits(cfg.mode, env, cfg.risk.max_leverage)
+    key, secret, names = _keys(exchange, cfg.mode, env)
+    if not key or not secret:
+        raise LiveRefused(f"{names} 이 필요합니다(.env). 키는 거래 권한만, 출금 권한은 끄고, IP 제한을 거세요.")
+    if cfg.mode == "live":
+        if not getattr(cfg, "live_enabled", False):
+            raise LiveRefused("메인넷 실거래는 config의 live_enabled=true 가 필요합니다.")
+        if not getattr(args, "i_understand_live_trading", False):
+            raise LiveRefused("메인넷 실거래는 --i-understand-live-trading 플래그가 필요합니다.")
+        ok, why = testnet_pass_ok(clock(), pass_path, exchange)
+        if not ok:
+            raise LiveRefused(why + ". 먼저 `python -m ena_bot.trend_live --test-order` 왕복 시험을 통과하세요(테스트넷, 또는 메인넷 극소액 $12).")
+        tty = sys.stdin.isatty() if isatty is None else isatty
+        if not tty:
+            raise LiveRefused("메인넷 실거래는 사람이 터미널에서 직접 시작해야 합니다(자동 실행·launchd 불가).")
+        phrase = f"LIVE {cfg.symbol} {int(limits.max_notional_usd)}USD"
+        typed = input_fn(f"메인넷({exchange})에서 실제 돈으로 주문합니다. 계속하려면 정확히 입력하세요 → {phrase}\n> ").strip()
+        if typed != phrase:
+            raise LiveRefused("확인 문구가 달라 시작하지 않습니다.")
+    broker = TrendLiveBroker(cfg, venue_factory(exchange, cfg.mode, key, secret), cfg.mode, limits, notifier, clock=clock, sleep=sleep)
+    broker.preflight()
+    return broker
