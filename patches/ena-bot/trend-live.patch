+class FakeClient:
+    """Bybit 단방향 계정을 흉내 낸다: 시장가 주문이 즉시 체결되고 포지션·손절·주문 ID 중복을 거래소처럼 처리한다."""
+
+    def __init__(self, equity=1000.0, step=1.0, min_qty=1.0, fail_stop=False, never_fill=False, hedge=False, drop_stop_on_fill=False):
+        self.equity, self.step, self.min_qty = equity, step, min_qty
+        self.fail_stop, self.never_fill, self.hedge, self.drop_stop = fail_stop, never_fill, hedge, drop_stop_on_fill
+        self.pos, self.entry, self.stop = 0.0, 0.0, 0.0
+        self.orders, self.stops, self.links, self.leverage = [], [], set(), None
+
+    def get_instrument(self, symbol):
+        return Instrument(symbol, self.step, self.min_qty, 0.0001)
+
+    def get_equity(self):
+        return self.equity
+
+    def set_leverage(self, symbol, lev):
+        self.leverage = lev
+
+    def create_market_order(self, symbol, side, qty_str, link_id, stop_loss=None, reduce_only=False):
+        if link_id in self.links:
+            raise BybitError(tl.DUP_LINK_CODE, "dup", "/v5/order/create")
+        self.links.add(link_id)
+        q = float(qty_str) * (1 if side == "Buy" else -1)
+        if reduce_only and not (self.pos != 0 and (q > 0) != (self.pos > 0) and abs(q) <= abs(self.pos) + 1e-9):
+            raise BybitError(110017, "reduce-only rejected", "/v5/order/create")
+        self.orders.append({"side": side, "qty": float(qty_str), "reduce_only": reduce_only, "stop_loss": stop_loss})
+        if self.never_fill:
+            return {}
+        new = self.pos + q
+        if self.pos == 0 or (self.pos > 0) == (q > 0):
+            self.entry = (abs(self.pos) * self.entry + abs(q) * 0.5) / (abs(self.pos) + abs(q))
+        self.pos = new if abs(new) > 1e-9 else 0.0
+        if stop_loss and not self.drop_stop:
+            self.stop = float(stop_loss)
+        if self.pos == 0:
+            self.entry = self.stop = 0.0
+        return {}
+
+    def _request(self, method, path, params=None, signed=False):
+        if path == "/v5/position/list":
+            if self.hedge:
+                return {"list": [{"side": "Buy", "size": "0", "avgPrice": "0", "stopLoss": "0", "positionIdx": 1},
+                                 {"side": "Sell", "size": "0", "avgPrice": "0", "stopLoss": "0", "positionIdx": 2}]}
+            side = "Buy" if self.pos > 0 else "Sell" if self.pos < 0 else ""
+            return {"list": [{"side": side, "size": str(abs(self.pos)), "avgPrice": str(self.entry), "stopLoss": str(self.stop), "positionIdx": 0}]}
+        if path == "/v5/position/trading-stop":
+            if self.fail_stop:
+                raise BybitError(34040, "stop rejected", path)
+            self.stops.append(params)
+            self.stop = float(params["stopLoss"])
+            return {}
+        raise AssertionError(path)
+
+    def get_klines(self, symbol, interval, limit):
+        return SimpleNamespace(close=[0.5, 0.5])
+
+
+class Notes:
+    def __init__(self):
