+"""trend-run 이 mode=testnet/live 에서 거래소 브로커를 쓰도록 연결한다(main.py 3곳, trend_engine.py 1곳). 여러 번 실행해도 안전.
+위치를 하나라도 못 찾으면 아무 파일도 바꾸지 않는다.
+사용: .venv/bin/python tools/wire_trend_live.py [프로젝트 폴더]
+"""
+import sys
+from pathlib import Path
+
+root = Path(sys.argv[1] if len(sys.argv) > 1 else ".")
+main_py, engine_py = root / "ena_bot/main.py", root / "ena_bot/trend_engine.py"
+
+A = '''    if cfg.mode != "paper":
+        print("trend-run은 페이퍼 모드 전용입니다(config의 mode=paper). 실거래 주문은 아직 구현하지 않았습니다.", file=sys.stderr)
+        return 2
+'''
+A2 = "    # 실거래(testnet/live)는 아래 make_trend_broker 가 모든 조건을 확인한 뒤에만 허용한다\n"
+B = "    eng = TrendEngine(cfg, client, PaperTrendBroker(cfg), store, notifier)\n"
+B2 = '''    from .trend_live import LiveRefused, make_trend_broker
+    try:
+        broker = make_trend_broker(cfg, args, os.environ, PaperTrendBroker, notifier)
+    except LiveRefused as exc:
+        print(f"실거래를 시작하지 않았습니다: {exc}", file=sys.stderr)
+        return 2
+    eng = TrendEngine(cfg, client, broker, store, notifier)
+'''
+C = '''    s = sub.add_parser("trend-run")
+    s.add_argument("--env", default=".env")
+    s.add_argument("--once", action="store_true")
+'''
+C2 = C + '    s.add_argument("--i-understand-live-trading", action="store_true", help="mode=live(메인넷 실거래)에 필요")\n'
+D = '        self.notifier.send(f"추세추종 페이퍼 시작 {self.cfg.symbol} equity={self.broker.balance:.2f} (실거래 주문 없음)")\n'
+D2 = ('        self.notifier.send(getattr(self.broker, "startup_text", None)\n'
+      '                           or f"추세추종 페이퍼 시작 {self.cfg.symbol} equity={self.broker.balance:.2f} (실거래 주문 없음)")\n')
+
+jobs = [(main_py, A, A2), (main_py, B, B2), (main_py, C, C2), (engine_py, D, D2)]
+texts = {main_py: main_py.read_text(encoding="utf-8"), engine_py: engine_py.read_text(encoding="utf-8")}
+todo = []
+for path, old, new in jobs:
+    if new in texts[path]:  # 이미 적용됨(새 내용이 옛 내용을 포함해도 이 검사가 먼저다)
+        continue
+    if texts[path].count(old) != 1:
+        raise SystemExit(f"{path.name}: 연결할 위치를 찾지 못했습니다({texts[path].count(old)}곳). 아무 파일도 바꾸지 않았습니다.")
+    todo.append((path, old, new))
+for path, old, new in todo:
+    texts[path] = texts[path].replace(old, new, 1)
+for path in {p for p, _, _ in todo}:
+    path.write_text(texts[path], encoding="utf-8")
+print("수정:", ", ".join(sorted({p.name for p, _, _ in todo})) if todo else "이미 적용됨")
