+        make(cfg("testnet"), env={})
+
+
+def test_mainnet_needs_every_gate(tmp_path):
+    ok = SimpleNamespace(i_understand_live_trading=True)
+    passfile = tmp_path / "pass.json"
+    typed = []
+    phrase = "LIVE ENAUSDT 150USD"
+
+    def go(c=None, a=ok, **kw):
+        return make(c or cfg("live", live_enabled=True), a, pass_path=passfile, isatty=True, input_fn=lambda p: typed[-1] if typed else "", clock=lambda: 1000.0, **kw)
+
+    with pytest.raises(tl.LiveRefused, match="live_enabled"):
+        go(c=cfg("live", live_enabled=False))
+    with pytest.raises(tl.LiveRefused, match="i-understand-live-trading"):
+        go(a=SimpleNamespace(i_understand_live_trading=False))
+    with pytest.raises(tl.LiveRefused, match="왕복 시험 통과 기록이 없습니다"):
+        go()
+    passfile.write_text(json.dumps({"ts": 1000.0 - 40 * 86400}))
+    with pytest.raises(tl.LiveRefused, match="40일 지났습니다"):
+        go()
+    passfile.write_text(json.dumps({"ts": 1000.0}))
+    with pytest.raises(tl.LiveRefused, match="터미널"):
+        make(cfg("live", live_enabled=True), ok, pass_path=passfile, isatty=False, clock=lambda: 1000.0)
+    typed.append("yes")
+    with pytest.raises(tl.LiveRefused, match="확인 문구"):
+        go()
+    typed.append(phrase)
+    b, seen = go()
+    assert b.mode == "live" and seen == {"url": tl.MAINNET, "key": "mk"} and "⚠ 메인넷 실거래" in b.startup_text
+    with pytest.raises(tl.LiveRefused, match="BYBIT_API_KEY"):
+        go(env={"BYBIT_TESTNET_API_KEY": "k", "BYBIT_TESTNET_API_SECRET": "s"})                 # 테스트넷 키로는 메인넷을 못 연다
+
+
+# ---------------------------------------------------------------- 점검 명령
+def test_check_without_orders_and_the_round_trip_rehearsal(tmp_path):
+    lines, made = [], []
+
+    def factory(url, key, secret):
+        made.append(FakeClient())
+        return made[-1]
+    ok = tl.run_check(cfg("testnet"), ENV, test_order=False, client_factory=factory, out=lines.append, pass_path=tmp_path / "p.json")
+    assert ok and not made[0].orders and not (tmp_path / "p.json").exists() and any("주문은 하지 않았습니다" in l for l in lines)
+    lines.clear()
+    ok = tl.run_check(cfg("testnet"), ENV, test_order=True, client_factory=factory, out=lines.append, pass_path=tmp_path / "p.json", sleep=lambda s: None)
+    c = made[-1]
+    assert ok and c.pos == 0.0 and (tmp_path / "p.json").exists() and "테스트넷 왕복 시험 통과" in lines[-1]
+    assert json.loads((tmp_path / "p.json").read_text())["network"] == "testnet"
+    assert [o["reduce_only"] for o in c.orders] == [False, True, False, True] and [o["side"] for o in c.orders] == ["Buy", "Sell", "Sell", "Buy"]
+    assert tl.testnet_pass_ok(path=tmp_path / "p.json")[0]
+
+
+def test_a_failed_rehearsal_writes_no_pass_record_and_cleans_up(tmp_path):
+    made = []
+
+    def factory(url, key, secret):
+        made.append(FakeClient(drop_stop_on_fill=True, fail_stop=True))
+        return made[-1]
+    out = []
+    ok = tl.run_check(cfg("testnet"), ENV, test_order=True, client_factory=factory, out=out.append, pass_path=tmp_path / "p.json", sleep=lambda s: None)
+    assert not ok and not (tmp_path / "p.json").exists() and made[0].pos == 0.0 and "메인넷 본 실행은 열 수 없습니다" in out[-1]
+
+
+def _mainnet_check(tmp_path, *, live_enabled=True, flag=True, tty=True, typed="LIVE ENAUSDT TEST 12USD", equity=1000.0):
+    out, made = [], []
+
+    def factory(url, key, secret):
+        made.append(FakeClient(equity=equity))
+        made[-1].url = url
+        return made[-1]
+    ok = tl.run_check(cfg("live", live_enabled=live_enabled), ENV, test_order=True, client_factory=factory, out=out.append, pass_path=tmp_path / "p.json",
+                      sleep=lambda s: None, args=SimpleNamespace(i_understand_live_trading=flag), input_fn=lambda p: typed, isatty=tty)
+    return ok, out, made
+
+
+def test_mainnet_rehearsal_needs_the_same_gates_and_sends_nothing_when_refused(tmp_path):
+    for kw, msg in (({"live_enabled": False}, "live_enabled"), ({"flag": False}, "i-understand"), ({"tty": False}, "터미널"), ({"typed": "yes"}, "확인 문구")):
+        ok, out, made = _mainnet_check(tmp_path, **kw)
+        assert not ok and msg in out[-1] and not made and not (tmp_path / "p.json").exists(), (kw, out)
+
+
+def test_mainnet_rehearsal_uses_a_tiny_size_and_unlocks_the_real_run(tmp_path):
+    ok, out, made = _mainnet_check(tmp_path)
+    c = made[-1]
+    assert ok and c.url == tl.MAINNET and c.pos == 0.0
+    assert [o["qty"] for o in c.orders] == [24.0, 24.0, 24.0, 24.0]               # $12 / 0.5 = 24 ENA, 닫기+열기 포함
+    assert max(o["qty"] * 0.5 for o in c.orders) <= 12.0 and c.leverage == 1.0
+    rec = json.loads((tmp_path / "p.json").read_text())
+    assert rec["network"] == "mainnet" and "메인넷 왕복 시험 통과" in out[-1]
+    assert tl.testnet_pass_ok(path=tmp_path / "p.json")[0]
+
+
+def test_mainnet_rehearsal_refuses_when_the_minimum_order_is_bigger_than_the_test_cap(tmp_path):
+    out = []
+    ok = tl.run_check(cfg("live", live_enabled=True), ENV, test_order=True, client_factory=lambda *a: FakeClient(min_qty=1000.0, step=1000.0), out=out.append,
+                      pass_path=tmp_path / "p.json", args=SimpleNamespace(i_understand_live_trading=True), input_fn=lambda p: "LIVE ENAUSDT TEST 12USD", isatty=True)
+    assert not ok and "시험 상한" in out[-1] and not (tmp_path / "p.json").exists()
+
+
+# ---------------------------------------------------------------- 연결 스크립트
+def test_wire_tool_is_atomic_and_idempotent(tmp_path):
+    (tmp_path / "ena_bot").mkdir()
+    main = ('def cmd_trend_run(cfg, args):\n    load_env(args.env)\n    if cfg.mode != "paper":\n'
+            '        print("trend-run은 페이퍼 모드 전용입니다(config의 mode=paper). 실거래 주문은 아직 구현하지 않았습니다.", file=sys.stderr)\n        return 2\n'
+            '    store = 1\n    notifier = 2\n    client = 3\n    eng = TrendEngine(cfg, client, PaperTrendBroker(cfg), store, notifier)\n    return 0\n\n\n'
+            'def build():\n    s = sub.add_parser("trend-run")\n    s.add_argument("--env", default=".env")\n    s.add_argument("--once", action="store_true")\n')
+    eng = ('class E:\n    def startup(self):\n        self.notifier.send(f"추세추종 페이퍼 시작 {self.cfg.symbol} equity={self.broker.balance:.2f} (실거래 주문 없음)")\n')
+    (tmp_path / "ena_bot/main.py").write_text(main)
+    (tmp_path / "ena_bot/trend_engine.py").write_text(eng)
+    run = lambda: subprocess.run([sys.executable, str(TOOL), str(tmp_path)], capture_output=True, text=True)
+    r = run()
+    assert r.returncode == 0, r.stderr
+    m, e = (tmp_path / "ena_bot/main.py").read_text(), (tmp_path / "ena_bot/trend_engine.py").read_text()
+    compile(m, "m", "exec"); compile(e, "e", "exec")
+    assert "make_trend_broker" in m and "PaperTrendBroker(cfg), store" not in m and "i-understand-live-trading" in m and "startup_text" in e
+    assert "이미 적용됨" in run().stdout and (tmp_path / "ena_bot/main.py").read_text() == m
+    # 위치가 하나라도 없으면 둘 다 그대로
+    (tmp_path / "ena_bot/main.py").write_text("x = 1\n")
+    (tmp_path / "ena_bot/trend_engine.py").write_text(eng)
+    r = run()
+    assert r.returncode != 0 and (tmp_path / "ena_bot/trend_engine.py").read_text() == eng
