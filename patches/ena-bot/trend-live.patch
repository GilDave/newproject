+    assert b.accrue_funding(0.5, 4) is None and b.accrue_funding_actual(0.5, [0.0001]) == 0.0
+    st = b.state_dict()
+    assert st["qty"] == 100.0 and st["balance"] == 1000.0 and st["live"] == "testnet" and {"entry", "total_fees"} <= set(st)
+    b.load_state({"orders": 7, "qty": 999})                     # 저장된 수량은 믿지 않고 거래소를 기준으로 한다
+    assert b.qty == 100.0 and "테스트넷 실주문" in b.startup_text
+
+
+# ---------------------------------------------------------------- 시작 조건
+ENV = {"BYBIT_TESTNET_API_KEY": "k", "BYBIT_TESTNET_API_SECRET": "s", "BYBIT_API_KEY": "mk", "BYBIT_API_SECRET": "ms"}
+
+
+class Paper:
+    def __init__(self, cfg):
+        self.cfg = cfg
+
+
+def make(cfg_, args=None, env=None, **kw):
+    seen = {}
+
+    def factory(url, key, secret):
+        seen.update(url=url, key=key)
+        return FakeClient()
+    kw.setdefault("client_factory", factory)
+    b = tl.make_trend_broker(cfg_, args or SimpleNamespace(i_understand_live_trading=False), ENV if env is None else env, Paper, Notes(), **kw)
+    return b, seen
+
+
+def test_paper_mode_keeps_the_paper_broker_and_testnet_uses_the_testnet_endpoint_and_keys():
+    assert isinstance(make(cfg("paper"))[0], Paper)
