@@ -0,0 +1,478 @@
+"""4시간봉 추세 엔진용 거래소 브로커(테스트넷 우선, 메인넷은 여러 겹의 안전장치 뒤에서만).
+
+엔진(TrendEngine)은 브로커에 목표 수량만 알려 주고(`rebalance(목표수량, 가격)`), 이 브로커가 거래소의 '실제' 포지션을 읽어
+차이만큼 주문한다. 원칙:
+- 거래소가 기준이다: 매 사이클 포지션·잔고를 다시 읽고, 주문 뒤에는 반영될 때까지 확인한다. 반영이 확인되지 않으면 재주문하지 않고 멈춘다.
+- 상한은 코드에 박혀 있다(1회 주문, 총 명목가, 레버리지). 환경 변수로는 낮추기만 할 수 있다.
+- 포지션에는 항상 거래소 측 손절이 붙는다. 손절을 걸지 못하면 포지션을 닫고 멈춘다.
+- 킬 스위치(STOP 파일)가 있으면 늘리는 주문은 하지 않고 정리만 한다.
+- 메인넷은 live_enabled + 확인 플래그 + 테스트넷 왕복 시험 통과 기록 + 직접 입력한 확인 문구가 모두 있어야 한다.
+"""
+
+from __future__ import annotations
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import sys
+import time
+from dataclasses import dataclass
+from decimal import ROUND_DOWN, ROUND_HALF_UP, Decimal
+from pathlib import Path
+
+from .exchange import MAINNET, TESTNET, BybitClient, BybitError
+
+# 메인넷 상한은 일부러 아주 작다. 올리려면 이 파일을 고쳐야 한다(환경 변수로는 낮추기만 가능).
+HARD_LIMITS = {
+    "testnet": {"max_notional_usd": 20000.0, "max_order_usd": 5000.0, "max_leverage": 2.0},
+    "live": {"max_notional_usd": 150.0, "max_order_usd": 100.0, "max_leverage": 1.5},
+}
+DEFAULT_STOP_PCT = 0.10
+STOP_PCT_RANGE = (0.02, 0.30)
+PASS_FILE = Path("data") / "trend_testnet_pass.json"  # 왕복 시험(테스트넷 또는 메인넷 극소액) 통과 기록
+MAINNET_TEST_USD = 12.0        # 메인넷 왕복 시험의 주문 크기(명목가). 수수료는 몇 센트 수준
+MAINNET_TEST_CAP_USD = 25.0    # 시험 중에는 상한도 이 값으로 낮춘다
+PASS_MAX_AGE_DAYS = 30
+DUP_LINK_CODE = 110072  # 같은 orderLinkId로 다시 보냄
+
+
+class LiveRefused(RuntimeError):
+    """시작 조건을 채우지 못해 실거래 브로커를 만들지 않았다."""
+
+
+class LiveSafetyError(RuntimeError):
+    """주문 중 안전 조건이 깨졌다(반영 미확인, 손절 실패 등). 엔진은 이 사이클을 처리하지 않은 채 멈춘다."""
+
+
+@dataclass
+class LiveLimits:
+    max_notional_usd: float
+    max_order_usd: float
+    max_leverage: float
+    stop_pct: float
+
+
+def _env_float(env, name: str, hard: float, lo: float = 0.0) -> float:
+    raw = (env.get(name) or "").strip()
+    if not raw:
+        return hard
+    try:
+        v = float(raw)
+    except ValueError as exc:
+        raise LiveRefused(f"{name} 값이 숫자가 아닙니다: {raw!r}") from exc
+    if not (v > lo) or math.isnan(v):
+        raise LiveRefused(f"{name}은 {lo}보다 커야 합니다: {raw!r}")
+    return min(v, hard)  # 낮추기만 한다
+
+
+def resolve_limits(mode: str, env, risk_max_leverage: float) -> LiveLimits:
+    hard = HARD_LIMITS["live" if mode == "live" else "testnet"]
+    raw = (env.get("ENA_LIVE_HARD_STOP_PCT") or "").strip()
+    pct = DEFAULT_STOP_PCT
+    if raw:
+        try:
+            pct = float(raw)
+        except ValueError as exc:
+            raise LiveRefused(f"ENA_LIVE_HARD_STOP_PCT 값이 숫자가 아닙니다: {raw!r}") from exc
+    if not (STOP_PCT_RANGE[0] <= pct <= STOP_PCT_RANGE[1]):
+        raise LiveRefused(f"거래소 손절 거리(ENA_LIVE_HARD_STOP_PCT)는 {STOP_PCT_RANGE[0]:.0%}~{STOP_PCT_RANGE[1]:.0%} 사이여야 합니다: {pct}")
+    return LiveLimits(
+        max_notional_usd=_env_float(env, "ENA_LIVE_MAX_NOTIONAL_USD", hard["max_notional_usd"]),
+        max_order_usd=_env_float(env, "ENA_LIVE_MAX_ORDER_USD", hard["max_order_usd"]),
+        max_leverage=min(_env_float(env, "ENA_LIVE_MAX_LEVERAGE", hard["max_leverage"]), float(risk_max_leverage)),
+        stop_pct=pct,
+    )
+
+
+def _dec(x) -> Decimal:
+    return Decimal(str(x))
+
+
+def _floor(x: float, step: float) -> float:
+    if step <= 0:
+        return float(x)
+    return float((_dec(x) / _dec(step)).to_integral_value(rounding=ROUND_DOWN) * _dec(step))
+
+
+def _fmt(x: float, step: float, rounding=ROUND_DOWN) -> str:
+    d = (_dec(x) / _dec(step)).to_integral_value(rounding=rounding) * _dec(step)
+    return format(d.normalize(), "f")
+
+
+class TrendLiveBroker:
+    """TrendEngine이 쓰는 브로커 인터페이스(qty, balance, equity, rebalance, state_dict …)를 거래소 주문으로 구현한다."""
+
+    live = True
+
+    def __init__(self, cfg, client, mode: str, limits: LiveLimits, notifier=None, *, clock=time.time, sleep=time.sleep,
+                 stop_files=None, confirm_polls: int = 15):
+        self.cfg, self.client, self.mode, self.limits, self.notifier = cfg, client, mode, limits, notifier
+        self.symbol = cfg.symbol
+        self.clock, self.sleep, self.confirm_polls = clock, sleep, confirm_polls
+        self.total_fees = 0.0  # 거래소 정산값을 쓰므로 가상 수수료 누적은 없다
+        self._equity = 0.0
+        self._inst = None
+        self._snap = (0.0, 0.0, 0.0, 0.0)  # (조회 시각, 부호 있는 수량, 평균 진입가, 거래소 손절가)
+        self._orders = 0
+        self._stop_files = stop_files if stop_files is not None else [Path(cfg.data_path) / "STOP", Path("data") / "STOP"]
+
+    # ------------------------------------------------------------------ 거래소 상태
+    def _say(self, text: str) -> None:
+        tag = "테스트넷" if self.mode != "live" else "⚠ 메인넷"
+        if self.notifier is not None:
+            try:
+                self.notifier.send(f"[{tag} 실주문] {text}")
+            except Exception:  # noqa: BLE001 - 알림 실패가 주문 안전 흐름을 깨면 안 된다
+                pass
+
+    def instrument(self):
+        if self._inst is None:
+            self._inst = self.client.get_instrument(self.symbol)
+        return self._inst
+
+    def _killed(self) -> bool:
+        return any(Path(p).exists() for p in self._stop_files)
+
+    def refresh(self, force: bool = False) -> tuple[float, float, float]:
+        """거래소의 실제 포지션을 읽는다(2초 캐시). (부호 있는 수량, 평균 진입가, 손절가). 단방향 모드가 아니면 거부한다."""
+        now = self.clock()
+        if not force and now - self._snap[0] < 2.0 and self._snap[0] > 0:
+            return self._snap[1:]
+        res = self.client._request("GET", "/v5/position/list", {"category": "linear", "symbol": self.symbol}, signed=True)
+        rows = res.get("list", []) or []
+        if any(int(p.get("positionIdx") or 0) != 0 for p in rows):
+            raise LiveRefused("이 계정은 헤지 모드로 보입니다. 단방향(one-way) 포지션 모드로 바꾼 뒤 사용하세요.")
+        qty = entry = stop = 0.0
+        for p in rows:
+            size = float(p.get("size") or 0)
+            if size > 0:
+                qty = size if p.get("side") == "Buy" else -size
+                entry, stop = float(p.get("avgPrice") or 0), float(p.get("stopLoss") or 0)
+                break
+        self._snap = (now, qty, entry, stop)
+        return qty, entry, stop
+
+    @property
+    def qty(self) -> float:
+        return self.refresh()[0]
+
+    @property
+    def entry(self) -> float:
+        return self.refresh()[1]
+
+    @property
+    def balance(self) -> float:
+        if self._equity <= 0:
+            self._equity = float(self.client.get_equity())
+        return self._equity
+
+    def equity(self, price: float) -> float:
+        self._equity = float(self.client.get_equity())
+        qty, entry, stop = self.refresh()
+        if qty != 0 and stop <= 0:  # 거래소 손절이 없는 포지션은 허용하지 않는다(수동 변경·취소 대비)
+            self._set_stop(qty, entry or price)
+        return self._equity
+
+    # 펀딩비는 거래소가 잔고에서 직접 정산한다
+    def accrue_funding(self, price: float, hours: float) -> None:
+        return None
+
+    def accrue_funding_actual(self, price: float, rates: list) -> float:
+        return 0.0
+
+    # ------------------------------------------------------------------ 손절
+    def _stop_price(self, signed_qty: float, ref: float) -> str:
+        inst = self.instrument()
+        raw = ref * (1 - self.limits.stop_pct) if signed_qty > 0 else ref * (1 + self.limits.stop_pct)
+        return _fmt(raw, inst.tick_size, ROUND_HALF_UP)
+
+    def _set_stop(self, signed_qty: float, ref: float) -> None:
+        params = {"category": "linear", "symbol": self.symbol, "stopLoss": self._stop_price(signed_qty, ref), "slTriggerBy": "MarkPrice",
+                  "tpslMode": "Full", "positionIdx": 0}
+        self.client._request("POST", "/v5/position/trading-stop", params, signed=True)
+        self._snap = (0.0, *self._snap[1:])  # 다음 조회는 거래소에서 다시 읽는다
+
+    # ------------------------------------------------------------------ 주문
+    def _link_id(self, leg: str, side: str, qty_str: str) -> str:
+        bucket = int(self.clock() // (4 * 3600))  # 같은 4시간 봉에서 같은 주문을 다시 보내면 거래소가 거부한다(중복 방지)
+        h = hashlib.sha1(f"{self.symbol}|{bucket}|{leg}|{side}|{qty_str}".encode()).hexdigest()[:20]
+        return f"ena{self.mode[0]}{h}"
+
+    def _wait_for(self, expected: float) -> float:
+        step = self.instrument().qty_step
+        got = 0.0
+        for i in range(self.confirm_polls):
+            got = self.refresh(force=True)[0]
+            if abs(got - expected) <= step / 2:
+                return got
+            self.sleep(1.0)
+        raise LiveSafetyError(f"주문 반영을 확인하지 못했습니다(기대 {expected:+g}, 실제 {got:+g}). 재주문하지 않고 멈춥니다. 거래소 앱에서 포지션을 확인하세요.")
+
+    def _send(self, leg: str, side: str, qty: float, *, reduce_only: bool, stop_ref: float | None, expected_after: float) -> None:
+        inst = self.instrument()
+        qty_str = _fmt(qty, inst.qty_step)
+        link = self._link_id(leg, side, qty_str)
+        stop = None
+        if stop_ref is not None:
+            stop = self._stop_price(1.0 if side == "Buy" else -1.0, stop_ref)
+        try:
+            self.client.create_market_order(self.symbol, side, qty_str, link, stop_loss=stop, reduce_only=reduce_only)
+        except BybitError as exc:
+            if exc.code != DUP_LINK_CODE:
+                raise
+            self._say(f"같은 주문 ID가 이미 있어 재전송하지 않고 반영만 확인합니다({leg})")  # 응답 유실 뒤 재시도: 이미 나간 주문
+        self._orders += 1
+        self._wait_for(expected_after)
+
+    def _flatten(self, reason: str) -> None:
+        qty = self.refresh(force=True)[0]
+        if qty != 0:
+            self._send("flat", "Sell" if qty > 0 else "Buy", abs(qty), reduce_only=True, stop_ref=None, expected_after=0.0)
+        self._say(f"포지션을 정리했습니다: {reason}")
+
+    def _cap_qty(self, price: float, equity: float) -> float:
+        lim = self.limits
+        by_notional = lim.max_notional_usd / price
+        by_leverage = lim.max_leverage * equity / price
+        return _floor(max(0.0, min(by_notional, by_leverage)), self.instrument().qty_step)
+
+    def rebalance(self, target_qty: float, price: float) -> float:
+        """목표 수량(부호 있음)으로 맞춘다. 거래소에서 실제로 바뀐 수량(부호 있음)을 돌려준다."""
+        if not price > 0:
+            raise LiveSafetyError(f"가격이 올바르지 않습니다: {price}")
+        inst = self.instrument()
+        step, min_qty = inst.qty_step, inst.min_qty
+        cur, entry, _ = self.refresh(force=True)
+        start_qty = cur
+        eq = self.equity(price)
+        sign = 1.0 if target_qty >= 0 else -1.0
+        why = ""
+        if self._killed():
+            tgt, why = 0.0, " (킬 스위치: 정리만 합니다)"
+        else:
+            tgt = sign * min(_floor(abs(target_qty), step), self._cap_qty(price, eq))
+            if abs(tgt) < min_qty:
+                tgt = 0.0
+        if abs(tgt - cur) < max(min_qty, step) - 1e-12:
+            return 0.0
+
+        max_order_qty = _floor(self.limits.max_order_usd / price, step)
+        flip = cur != 0 and (tgt == 0 or (tgt > 0) != (cur > 0))
+        if flip:  # 반대 방향이면 먼저 줄이기 전용으로 모두 닫고, 그다음 새로 연다
+            self._send("close", "Sell" if cur > 0 else "Buy", abs(cur), reduce_only=True, stop_ref=None, expected_after=0.0)
+            cur = 0.0
+        if tgt != 0 and abs(tgt) > abs(cur):  # 늘리기(신규 포함): 1회 주문 상한을 넘지 않는다
+            add = min(abs(tgt) - abs(cur), max_order_qty)
+            if add >= min_qty:
+                side = "Buy" if tgt > 0 else "Sell"
+                after = cur + (add if tgt > 0 else -add)
+                self._send("open" if cur == 0 else "add", side, add, reduce_only=False, stop_ref=price, expected_after=after)
+                cur = after
+        elif tgt != 0 and abs(tgt) < abs(cur):  # 줄이기: 상한 없이 전량 허용
+            cut = abs(cur) - abs(tgt)
+            self._send("cut", "Sell" if cur > 0 else "Buy", cut, reduce_only=True, stop_ref=None, expected_after=tgt)
+            cur = tgt
+        final, avg, stop = self.refresh(force=True)
+        if final != 0:  # 평균 진입가가 바뀌었으니 손절을 다시 맞춘다. 실패하면 포지션을 닫고 멈춘다
+            try:
+                self._set_stop(final, avg or price)
+                if self.refresh(force=True)[2] <= 0:
+                    raise LiveSafetyError("거래소에 손절이 등록되지 않았습니다")
+            except (BybitError, LiveSafetyError) as exc:
+                self._flatten(f"거래소 손절을 걸지 못함 ({exc})")
+                raise LiveSafetyError(f"거래소 손절을 걸지 못해 포지션을 정리했습니다: {exc}") from exc
+        return final - start_qty
+
+    # ------------------------------------------------------------------ 엔진 상태 저장
+    def state_dict(self) -> dict:
+        qty, entry, _ = self.refresh()
+        return {"balance": self._equity, "qty": qty, "entry": entry, "total_fees": 0.0, "live": self.mode, "orders": self._orders}
+
+    def load_state(self, d: dict) -> None:
+        self._orders = int(d.get("orders", 0)) if isinstance(d, dict) else 0
+
+    @property
+    def startup_text(self) -> str:
+        lim = self.limits
+        label = "테스트넷 실주문" if self.mode != "live" else "⚠ 메인넷 실거래"
+        return (f"추세추종 {label} 시작 {self.symbol} equity={self.balance:.2f} · 상한 명목가 ${lim.max_notional_usd:g} · "
+                f"1회 ${lim.max_order_usd:g} · 레버리지 {lim.max_leverage:g}x · 거래소 손절 {lim.stop_pct:.0%}")
+
+    def preflight(self) -> dict:
+        """주문 없이 계정·상품·포지션 모드를 점검한다. 문제가 있으면 LiveRefused."""
+        inst = self.instrument()
+        qty, entry, stop = self.refresh(force=True)
+        eq = float(self.client.get_equity())
+        if not eq > 0:
+            raise LiveRefused(f"계정 자본이 0 이하입니다({eq}). 입금 또는 테스트넷 faucet을 확인하세요.")
+        self.client.set_leverage(self.symbol, self.limits.max_leverage)
+        self._equity = eq
+        return {"equity": eq, "qty": qty, "entry": entry, "stop": stop, "min_qty": inst.min_qty, "qty_step": inst.qty_step, "tick": inst.tick_size}
+
+
+# ---------------------------------------------------------------------- 만들기(시작 조건)
+def _keys(mode: str, env) -> tuple[str, str]:
+    if mode == "live":
+        return (env.get("BYBIT_API_KEY") or "").strip(), (env.get("BYBIT_API_SECRET") or "").strip()
+    return ((env.get("BYBIT_TESTNET_API_KEY") or env.get("BYBIT_API_KEY") or "").strip(),
+            (env.get("BYBIT_TESTNET_API_SECRET") or env.get("BYBIT_API_SECRET") or "").strip())
+
+
+def testnet_pass_ok(now: float | None = None, path: Path = PASS_FILE) -> tuple[bool, str]:
+    try:
+        d = json.loads(Path(path).read_text(encoding="utf-8"))
+        age = ((now if now is not None else time.time()) - float(d["ts"])) / 86400
+    except (OSError, ValueError, KeyError, TypeError):
+        return False, "왕복 시험 통과 기록이 없습니다"
+    if age > PASS_MAX_AGE_DAYS:
+        return False, f"왕복 시험 통과 기록이 {age:.0f}일 지났습니다(최대 {PASS_MAX_AGE_DAYS}일)"
+    return True, ""
+
+
+def make_trend_broker(cfg, args, env, paper_cls, notifier=None, *, client_factory=BybitClient, input_fn=input, isatty=None, pass_path: Path = PASS_FILE,
+                      clock=time.time, sleep=time.sleep):
+    """config의 mode에 맞는 브로커. paper면 기존 페이퍼 브로커. 조건이 모자라면 LiveRefused."""
+    if cfg.mode == "paper":
+        return paper_cls(cfg)
+    if cfg.mode not in ("testnet", "live"):
+        raise LiveRefused(f"알 수 없는 mode: {cfg.mode}")
+    limits = resolve_limits(cfg.mode, env, cfg.risk.max_leverage)
+    key, secret = _keys(cfg.mode, env)
+    if not key or not secret:
+        names = "BYBIT_API_KEY / BYBIT_API_SECRET" if cfg.mode == "live" else "BYBIT_TESTNET_API_KEY / BYBIT_TESTNET_API_SECRET"
+        raise LiveRefused(f"{names} 이 필요합니다(.env). 키는 거래 권한만, 출금 권한은 끄고, IP 제한을 거세요.")
+    if cfg.mode == "live":
+        if not getattr(cfg, "live_enabled", False):
+            raise LiveRefused("메인넷 실거래는 config의 live_enabled=true 가 필요합니다.")
+        if not getattr(args, "i_understand_live_trading", False):
+            raise LiveRefused("메인넷 실거래는 --i-understand-live-trading 플래그가 필요합니다.")
+        ok, why = testnet_pass_ok(clock(), pass_path)
+        if not ok:
+            raise LiveRefused(why + ". 먼저 `python -m ena_bot.trend_live --test-order` 왕복 시험을 통과하세요(테스트넷, 또는 메인넷 극소액 $12).")
+        tty = sys.stdin.isatty() if isatty is None else isatty
+        if not tty:
+            raise LiveRefused("메인넷 실거래는 사람이 터미널에서 직접 시작해야 합니다(자동 실행·launchd 불가).")
+        phrase = f"LIVE {cfg.symbol} {int(limits.max_notional_usd)}USD"
+        typed = input_fn(f"메인넷에서 실제 돈으로 주문합니다. 계속하려면 정확히 입력하세요 → {phrase}\n> ").strip()
+        if typed != phrase:
+            raise LiveRefused("확인 문구가 달라 시작하지 않습니다.")
+    client = client_factory(TESTNET if cfg.mode == "testnet" else MAINNET, key, secret)
+    broker = TrendLiveBroker(cfg, client, cfg.mode, limits, notifier, clock=clock, sleep=sleep)
+    broker.preflight()
+    return broker
+
+
+# ---------------------------------------------------------------------- 점검 명령
+def run_check(cfg, env, *, test_order: bool, client_factory=BybitClient, out=print, pass_path: Path = PASS_FILE, sleep=time.sleep, clock=time.time,
+              args=None, input_fn=input, isatty=None) -> bool:
+    mode = cfg.mode
+    if mode not in ("testnet", "live"):
+        out("config의 mode가 testnet 또는 live 이어야 점검할 수 있습니다(지금: %s)." % mode)
+        return False
+    limits = resolve_limits(mode, env, cfg.risk.max_leverage)
+    test_usd = 15.0
+    if test_order and mode == "live":  # 메인넷 왕복 시험: 실제 돈이므로 본 실행과 같은 문턱 + 아주 작은 크기
+        try:
+            if not getattr(cfg, "live_enabled", False):
+                raise LiveRefused("메인넷 시험 주문은 config의 live_enabled=true 가 필요합니다.")
+            if not getattr(args, "i_understand_live_trading", False):
+                raise LiveRefused("메인넷 시험 주문은 --i-understand-live-trading 플래그가 필요합니다.")
+            if not (sys.stdin.isatty() if isatty is None else isatty):
+                raise LiveRefused("메인넷 시험 주문은 사람이 터미널에서 직접 실행해야 합니다.")
+            phrase = f"LIVE {cfg.symbol} TEST {int(MAINNET_TEST_USD)}USD"
+            if input_fn(f"메인넷에서 실제 돈으로 약 ${MAINNET_TEST_USD:g}짜리 시험 주문 4번(진입 → 전환 때 닫기+새로 열기 → 정리)을 냅니다. 계속하려면 정확히 입력하세요 → {phrase}\n> ").strip() != phrase:
+                raise LiveRefused("확인 문구가 달라 시작하지 않습니다.")
+        except LiveRefused as exc:
+            out(f"✗ {exc}")
+            return False
+        limits = LiveLimits(min(limits.max_notional_usd, MAINNET_TEST_CAP_USD), min(limits.max_order_usd, MAINNET_TEST_CAP_USD), 1.0, limits.stop_pct)
+        test_usd = MAINNET_TEST_USD
+    key, secret = _keys(mode, env)
+    if not key or not secret:
+        out("API 키가 .env 에 없습니다.")
+        return False
+    client = client_factory(TESTNET if mode == "testnet" else MAINNET, key, secret)
+    broker = TrendLiveBroker(cfg, client, mode, limits, None, clock=clock, sleep=sleep)
+    try:
+        info = broker.preflight()
+    except (LiveRefused, BybitError) as exc:
+        out(f"✗ 점검 실패: {exc}")
+        return False
+    out(f"✓ 연결·권한 · 엔드포인트 {'테스트넷' if mode == 'testnet' else '메인넷'} · 자본 {info['equity']:.2f} USDT")
+    out(f"✓ 상품 {cfg.symbol} · 최소 수량 {info['min_qty']:g} · 수량 단위 {info['qty_step']:g} · 호가 단위 {info['tick']:g}")
+    out(f"✓ 포지션 모드 단방향 · 현재 포지션 {info['qty']:+g}" + (f" (진입 {info['entry']:g}, 손절 {info['stop']:g})" if info["qty"] else ""))
+    out(f"✓ 상한 · 총 명목가 ${limits.max_notional_usd:g} · 1회 ${limits.max_order_usd:g} · 레버리지 {limits.max_leverage:g}x · 거래소 손절 {limits.stop_pct:.0%}")
+    if not test_order:
+        out("주문은 하지 않았습니다. 왕복 시험은 --test-order (테스트넷 전용).")
+        return True
+    if info["qty"] != 0:
+        out("✗ 이미 포지션이 있어 시험하지 않습니다. 테스트넷에서 먼저 정리하세요.")
+        return False
+    try:
+        c = client.get_klines(cfg.symbol, 1, 2)
+        price = float(c.close[-1])
+    except Exception as exc:  # noqa: BLE001
+        out(f"✗ 현재가를 읽지 못했습니다: {exc}")
+        return False
+    qty = max(_floor(test_usd / price, broker.instrument().qty_step), broker.instrument().min_qty)
+    if qty * price > limits.max_order_usd:
+        out(f"✗ 최소 주문 수량({qty:g})이 시험 상한(${limits.max_order_usd:g})보다 큽니다. 시험하지 않습니다.")
+        return False
+    out(f"시험 주문 크기: {qty:g} {cfg.symbol.replace('USDT', '')} ≈ ${qty * price:.2f} · {'메인넷(실제 돈)' if mode == 'live' else '테스트넷'}")
+    ok = True
+    try:
+        for label, target, check in (
+            ("롱 진입 + 거래소 손절", +qty, lambda q, s: q > 0 and s > 0),
+            ("반대 방향 전환(먼저 닫고 새로 열기)", -qty, lambda q, s: q < 0 and s > 0),
+            ("전량 정리", 0.0, lambda q, s: q == 0),
+        ):
+            before = broker.refresh(force=True)[0]
+            moved = broker.rebalance(target, price)
+            q, _, s = broker.refresh(force=True)
+            good = check(q, s) and abs(moved - (q - before)) < broker.instrument().qty_step / 2
+            out(f"{'✓' if good else '✗'} {label} · 수량 {q:+g}" + (f" · 손절 {s:g}" if q else ""))
+            ok = ok and good
+            if not good:
+                break
+    except (LiveSafetyError, BybitError, LiveRefused) as exc:
+        out(f"✗ 시험 중 오류: {exc}")
+        ok = False
+    finally:
+        try:
+            if abs(broker.refresh(force=True)[0]) > 0:
+                broker.rebalance(0.0, price)
+                out("시험 포지션을 정리했습니다.")
+        except Exception as exc:  # noqa: BLE001
+            out(f"⚠ 시험 포지션 정리에 실패했습니다. 테스트넷 앱에서 직접 닫으세요: {exc}")
+            ok = False
+    if ok:
+        Path(pass_path).parent.mkdir(parents=True, exist_ok=True)
+        Path(pass_path).write_text(json.dumps({"ts": clock(), "symbol": cfg.symbol, "qty": qty, "network": "mainnet" if mode == "live" else "testnet"}), encoding="utf-8")
+        out(f"✓ {'메인넷' if mode == 'live' else '테스트넷'} 왕복 시험 통과 — 기록: {pass_path}")
+    else:
+        out("✗ 시험 실패. 메인넷 본 실행은 열 수 없습니다.")
+    return ok
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .config import load_config, load_env
+
+    ap = argparse.ArgumentParser(description="추세 엔진 실거래 브로커 점검(주문은 --test-order, 테스트넷 전용)")
+    ap.add_argument("--config", default="config.json")
+    ap.add_argument("--env", default=".env")
+    ap.add_argument("--check", action="store_true", help="연결·권한·상품·포지션 모드를 주문 없이 점검")
+    ap.add_argument("--test-order", action="store_true", help="최소 수량으로 진입→전환→정리 왕복 시험(테스트넷, 또는 메인넷 극소액)")
+    ap.add_argument("--i-understand-live-trading", action="store_true", help="메인넷 시험 주문에 필요")
+    args = ap.parse_args(argv)
+    if not (args.check or args.test_order):
+        ap.print_help()
+        return 2
+    load_env(args.env)
+    cfg = load_config(args.config)
+    return 0 if run_check(cfg, os.environ, test_order=args.test_order, args=args) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
