+# ---------------------------------------------------------------------- 점검 명령
+def run_check(cfg, env, *, test_order: bool, venue_factory=build_venue, out=print, pass_path: Path = PASS_FILE, sleep=time.sleep, clock=time.time,
+              args=None, input_fn=input, isatty=None) -> bool:
+    mode = cfg.mode
+    if mode not in ("testnet", "live"):
+        out("config의 mode가 testnet 또는 live 이어야 점검할 수 있습니다(지금: %s)." % mode)
+        return False
+    try:
+        exchange = resolve_exchange(env)
+        limits = resolve_limits(mode, env, cfg.risk.max_leverage)
+    except LiveRefused as exc:
+        out(f"✗ {exc}")
+        return False
+    test_usd = 15.0
+    if test_order and mode == "live":  # 메인넷 왕복 시험: 실제 돈이므로 본 실행과 같은 문턱 + 아주 작은 크기
+        try:
+            if not getattr(cfg, "live_enabled", False):
+                raise LiveRefused("메인넷 시험 주문은 config의 live_enabled=true 가 필요합니다.")
+            if not getattr(args, "i_understand_live_trading", False):
+                raise LiveRefused("메인넷 시험 주문은 --i-understand-live-trading 플래그가 필요합니다.")
+            if not (sys.stdin.isatty() if isatty is None else isatty):
+                raise LiveRefused("메인넷 시험 주문은 사람이 터미널에서 직접 실행해야 합니다.")
+            phrase = f"LIVE {cfg.symbol} TEST {int(MAINNET_TEST_USD)}USD"
+            if input_fn(f"메인넷({exchange})에서 실제 돈으로 약 ${MAINNET_TEST_USD:g}짜리 시험 주문 4번(진입 → 전환 때 닫기+새로 열기 → 정리)을 냅니다. "
+                        f"계속하려면 정확히 입력하세요 → {phrase}\n> ").strip() != phrase:
+                raise LiveRefused("확인 문구가 달라 시작하지 않습니다.")
+        except LiveRefused as exc:
+            out(f"✗ {exc}")
+            return False
+        limits = LiveLimits(min(limits.max_notional_usd, MAINNET_TEST_CAP_USD), min(limits.max_order_usd, MAINNET_TEST_CAP_USD), 1.0, limits.stop_pct)
+        test_usd = MAINNET_TEST_USD
+    key, secret, names = _keys(exchange, mode, env)
+    if not key or not secret:
+        out(f"✗ API 키가 .env 에 없습니다({names}).")
+        return False
+    broker = TrendLiveBroker(cfg, venue_factory(exchange, mode, key, secret), mode, limits, None, clock=clock, sleep=sleep)
+    try:
+        info = broker.preflight()
+    except LiveRefused as exc:
+        out(f"✗ 점검 실패: {exc}")
+        return False
+    net = "테스트넷" if mode == "testnet" else "메인넷"
+    out(f"✓ 연결·권한 · {exchange} {net} · 자본 {info['equity']:.2f} USDT")
+    out(f"✓ 상품 {cfg.symbol} · 최소 수량 {info['min_qty']:g} · 수량 단위 {info['qty_step']:g} · 호가 단위 {info['tick']:g} · 최소 주문 금액 ${info['min_notional']:g}")
+    out(f"✓ 포지션 모드 단방향 · 현재 포지션 {info['qty']:+g}" + (f" (진입 {info['entry']:g}, 손절 {info['stop']:g})" if info["qty"] else ""))
+    out(f"✓ 상한 · 총 명목가 ${limits.max_notional_usd:g} · 1회 ${limits.max_order_usd:g} · 레버리지 {limits.max_leverage:g}x · 거래소 손절 {limits.stop_pct:.0%}")
+    if not test_order:
+        out("주문은 하지 않았습니다. 왕복 시험은 --test-order.")
+        return True
+    if info["qty"] != 0:
+        out("✗ 이미 포지션이 있어 시험하지 않습니다. 먼저 정리하세요.")
+        return False
+    try:
+        price = float(broker.venue.last_price(cfg.symbol))
+    except Exception as exc:  # noqa: BLE001
+        out(f"✗ 현재가를 읽지 못했습니다: {exc}")
+        return False
+    inst = broker.instrument()
+    qty = max(_floor(test_usd / price, inst.qty_step), inst.min_qty)
+    if qty * price < float(getattr(inst, "min_notional", 0.0) or 0.0):
+        qty = _floor(float(inst.min_notional) * 1.2 / price, inst.qty_step) + inst.qty_step
+    if qty * price > limits.max_order_usd:
+        out(f"✗ 최소 주문 수량({qty:g})이 시험 상한(${limits.max_order_usd:g})보다 큽니다. 시험하지 않습니다.")
+        return False
+    out(f"시험 주문 크기: {qty:g} {cfg.symbol.replace('USDT', '')} ≈ ${qty * price:.2f} · {net}{'(실제 돈)' if mode == 'live' else ''}")
+    ok = True
+    try:
+        for label, target, check in (
+            ("롱 진입 + 거래소 손절", +qty, lambda q, s: q > 0 and s > 0),
+            ("반대 방향 전환(먼저 닫고 새로 열기)", -qty, lambda q, s: q < 0 and s > 0),
+            ("전량 정리(손절 주문도 정리)", 0.0, lambda q, s: q == 0),
+        ):
+            before = broker.refresh(force=True)[0]
+            moved = broker.rebalance(target, price)
+            q, _, s = broker.refresh(force=True)
+            good = check(q, s) and abs(moved - (q - before)) < inst.qty_step / 2
+            out(f"{'✓' if good else '✗'} {label} · 수량 {q:+g}" + (f" · 손절 {s:g}" if q else ""))
+            ok = ok and good
+            if not good:
+                break
+    except (LiveSafetyError, VenueError, LiveRefused) as exc:
+        out(f"✗ 시험 중 오류: {exc}")
+        ok = False
+    finally:
+        try:
+            if abs(broker.refresh(force=True)[0]) > 0:
+                broker.rebalance(0.0, price)
+                out("시험 포지션을 정리했습니다.")
+        except Exception as exc:  # noqa: BLE001
+            out(f"⚠ 시험 포지션 정리에 실패했습니다. 거래소 앱에서 직접 닫으세요: {exc}")
+            ok = False
+    if ok:
+        Path(pass_path).parent.mkdir(parents=True, exist_ok=True)
+        Path(pass_path).write_text(json.dumps({"ts": clock(), "symbol": cfg.symbol, "qty": qty, "network": "mainnet" if mode == "live" else "testnet",
+                                               "exchange": exchange}), encoding="utf-8")
+        out(f"✓ {net} 왕복 시험 통과 — 기록: {pass_path}")
+    else:
+        out("✗ 시험 실패. 메인넷 본 실행은 열 수 없습니다.")
+    return ok
+
+
+def main(argv: list[str] | None = None) -> int:
+    from .config import load_config, load_env
+
+    ap = argparse.ArgumentParser(description="추세 엔진 실거래 브로커 점검(주문은 --test-order). 거래소는 환경 변수 ENA_EXCHANGE=bybit|binance")
+    ap.add_argument("--config", default="config.json")
+    ap.add_argument("--env", default=".env")
+    ap.add_argument("--check", action="store_true", help="연결·권한·상품·포지션 모드를 주문 없이 점검")
+    ap.add_argument("--test-order", action="store_true", help="최소 수량으로 진입→전환→정리 왕복 시험(테스트넷, 또는 메인넷 극소액)")
+    ap.add_argument("--i-understand-live-trading", action="store_true", help="메인넷 시험 주문에 필요")
+    args = ap.parse_args(argv)
+    if not (args.check or args.test_order):
+        ap.print_help()
+        return 2
+    load_env(args.env)
+    cfg = load_config(args.config)
+    return 0 if run_check(cfg, os.environ, test_order=args.test_order, args=args) else 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
