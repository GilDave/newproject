+import hashlib
+import hmac
+import json
+import re
+from pathlib import Path
+from types import SimpleNamespace
+from urllib.parse import parse_qsl, urlsplit
+
+import pytest
+
+from ena_bot import trend_live as tl
+from ena_bot.live_venues import BINANCE_MAINNET, BINANCE_TESTNET, BinanceFutures, VenueError
+
+KEY, SECRET = "api-key", "api-secret"
+CLIENT_ID = re.compile(r"^[.A-Z:/a-z0-9_-]{1,36}$")
+
+
+class Resp:
+    def __init__(self, data, status=200):
+        self._d, self.status_code = data, status
+
+    def json(self):
+        return self._d
+
+
+def err(code, msg, status=400):
+    return Resp({"code": code, "msg": msg}, status)
+
+
+class FakeBinance:
+    """Binance USDⓈ-M 선물 서버 흉내: 서명·헤더를 검증하고, 일반 주문에는 손절 타입을 받지 않으며(알고 주문으로 옮겨짐), 시장가 중복 ID는 거부하지 않는다."""
+
+    def __init__(self, equity=1000.0, price=0.5, dual=False, fail_algo=False, ghost_first_post=False, lag_reads=0, step="1", min_qty="1", notional="5"):
+        self.equity, self.price, self.dual, self.fail_algo = equity, price, dual, fail_algo
+        self.pos, self.entry = 0.0, 0.0
+        self.orders, self.algos, self.deleted, self.requests, self.leverage = [], [], [], [], None
+        self.client_ids, self.next_algo = {}, 1
+        self.ghost, self.lag, self._pending = ghost_first_post, lag_reads, None
+        self.filters = [{"filterType": "LOT_SIZE", "minQty": "1", "maxQty": "1000000", "stepSize": "1"},
+                        {"filterType": "MARKET_LOT_SIZE", "minQty": min_qty, "maxQty": "500000", "stepSize": step},
+                        {"filterType": "PRICE_FILTER", "minPrice": "0.0001", "maxPrice": "100", "tickSize": "0.0001"},
+                        {"filterType": "MIN_NOTIONAL", "notional": notional}]
+
+    def request(self, method, url, headers=None, timeout=None):
+        parts = urlsplit(url)
+        path, q = parts.path, parse_qsl(parts.query, keep_blank_values=True)
+        params = dict(q)
+        self.requests.append((method, path, params))
+        public = path in ("/fapi/v1/exchangeInfo", "/fapi/v1/ticker/price")
+        if not public:
+            if (headers or {}).get("X-MBX-APIKEY") != KEY:
+                return err(-2014, "API-key format invalid.")
+            sig = params.pop("signature", None)
+            signed_query = "&".join(f"{k}={v}" for k, v in q if k != "signature")
+            good = hmac.new(SECRET.encode(), signed_query.encode(), hashlib.sha256).hexdigest()
+            if sig != good or "timestamp" not in params or "recvWindow" not in params:
+                return err(-1022, "Signature for this request is not valid.")
+        return getattr(self, "h_" + method.lower() + "_" + path.replace("/", "_"))(params)
+
+    # --- 공개
+    def h_get__fapi_v1_exchangeInfo(self, p):
+        return Resp({"symbols": [{"symbol": "ENAUSDT", "filters": self.filters}, {"symbol": "BTCUSDT", "filters": []}]})
+
+    def h_get__fapi_v1_ticker_price(self, p):
+        return Resp({"symbol": p["symbol"], "price": str(self.price), "time": 1})
+
+    # --- 계정
+    def h_get__fapi_v3_account(self, p):
+        return Resp({"totalWalletBalance": str(self.equity), "totalMarginBalance": str(self.equity), "availableBalance": str(self.equity)})
+
+    def h_get__fapi_v1_positionSide_dual(self, p):
+        return Resp({"dualSidePosition": self.dual})
+
+    def h_get__fapi_v3_positionRisk(self, p):
+        if self.lag > 0 and self._pending is not None:
+            self.lag -= 1
+            if self.lag == 0:
+                self.pos, self.entry = self._pending
+                self._pending = None
+        return Resp([{"symbol": "ENAUSDT", "positionSide": "BOTH", "positionAmt": str(self.pos), "entryPrice": str(self.entry if self.pos else 0), "markPrice": "0.5"}])
+
+    def h_post__fapi_v1_leverage(self, p):
+        self.leverage = int(p["leverage"])
+        return Resp({"symbol": p["symbol"], "leverage": self.leverage})
+
+    def h_get__fapi_v1_openAlgoOrders(self, p):
+        return Resp([a for a in self.algos if a["algoStatus"] == "NEW"])
+
+    # --- 주문
+    def h_get__fapi_v1_order(self, p):
+        o = self.client_ids.get(p.get("origClientOrderId"))
+        return Resp(o) if o else err(-2013, "Order does not exist.")
+
+    def h_post__fapi_v1_order(self, p):
+        assert p["type"] == "MARKET", "STOP 계열은 /fapi/v1/algoOrder 로 보내야 한다"
+        assert "stopPrice" not in p and "closePosition" not in p
+        assert CLIENT_ID.match(p["newClientOrderId"]), p["newClientOrderId"]
+        q = float(p["quantity"]) * (1 if p["side"] == "BUY" else -1)
+        if p.get("reduceOnly") == "true" and not (self.pos != 0 and (q > 0) != (self.pos > 0) and abs(q) <= abs(self.pos) + 1e-9):
+            return err(-2022, "ReduceOnly Order is rejected.")
+        o = {"symbol": p["symbol"], "clientOrderId": p["newClientOrderId"], "status": "FILLED", "executedQty": p["quantity"]}
+        self.orders.append({**p})
+        self.client_ids[p["newClientOrderId"]] = o            # 중복 ID를 거부하지 않는다(체결돼 닫힌 주문)
+        new = self.pos + q
+        entry = ((abs(self.pos) * self.entry + abs(q) * self.price) / (abs(self.pos) + abs(q))) if (self.pos == 0 or (self.pos > 0) == (q > 0)) else self.entry
+        new = new if abs(new) > 1e-9 else 0.0
+        if self.lag:
+            self._pending = (new, entry if new else 0.0)
+        else:
+            self.pos, self.entry = new, entry if new else 0.0
+        if self.ghost:                                          # 거래소는 받았지만 응답이 유실됐다
+            self.ghost = False
+            raise ConnectionError("read timed out")
+        return Resp(o)
+
+    def h_post__fapi_v1_algoOrder(self, p):
+        if self.fail_algo:
+            return err(-4509, "algo order rejected")
+        assert p["algoType"] == "CONDITIONAL" and p["type"] == "STOP_MARKET" and p["closePosition"] == "true" and p["workingType"] == "MARK_PRICE"
+        assert "quantity" not in p and "reduceOnly" not in p and CLIENT_ID.match(p["clientAlgoId"])
+        a = {"algoId": self.next_algo, "clientAlgoId": p["clientAlgoId"], "algoStatus": "NEW", "orderType": "STOP_MARKET", "side": p["side"],
+             "triggerPrice": p["triggerPrice"], "closePosition": True}
+        self.next_algo += 1
+        self.algos.append(a)
+        return Resp({"algoId": a["algoId"], "clientAlgoId": a["clientAlgoId"], "algoStatus": "NEW"})
+
+    def h_delete__fapi_v1_algoOrder(self, p):
+        for a in self.algos:
+            if a["algoId"] == int(p["algoId"]):
+                a["algoStatus"] = "CANCELED"
+                self.deleted.append(a["algoId"])
+                return Resp({"algoId": a["algoId"], "algoStatus": "CANCELED"})
+        return err(-2011, "Unknown order sent.")
+
+    def request_session(self):
+        return SimpleNamespace(request=self.request)
+
+    def open_algos(self):
+        return [a for a in self.algos if a["algoStatus"] == "NEW"]
+
+
+def venue(fb, base=BINANCE_TESTNET):
+    return BinanceFutures(base, KEY, SECRET, session=fb.request_session(), clock=lambda: 1_700_000_000.0)
+
+
+def cfg(mode="testnet", live_enabled=False):
+    return SimpleNamespace(symbol="ENAUSDT", mode=mode, live_enabled=live_enabled, risk=SimpleNamespace(max_leverage=3.0), data_path=Path("/nonexistent-ena"))
+
+
+def broker(fb=None, mode="testnet", **kw):
+    fb = fb or FakeBinance()
+    now = [1_000_000.0]
+    lim = tl.resolve_limits(mode, {}, 3.0)
+    b = tl.TrendLiveBroker(cfg(mode), venue(fb), mode, lim, None, clock=lambda: now[0], sleep=lambda s: None, stop_files=[], **kw)
+    b.now = now
+    return b, fb
+
+
+def test_requests_are_signed_and_use_the_documented_endpoints():
+    b, fb = broker()
+    info = b.preflight()
+    assert info["equity"] == 1000.0 and info["qty_step"] == 1.0 and info["tick"] == 0.0001 and info["min_notional"] == 5.0 and fb.leverage == 2     # 테스트넷 상한 레버리지 2배
+    paths = [p for _, p, _ in fb.requests]
+    assert "/fapi/v3/account" in paths and "/fapi/v1/positionSide/dual" in paths and "/fapi/v3/positionRisk" in paths and "/fapi/v1/leverage" in paths
+    signed = [r for r in fb.requests if r[1] not in ("/fapi/v1/exchangeInfo", "/fapi/v1/ticker/price")]
+    assert signed and all("recvWindow" in r[2] and "timestamp" in r[2] for r in signed)       # 서명이 틀리면 가짜 서버가 -1022로 거부한다
+
